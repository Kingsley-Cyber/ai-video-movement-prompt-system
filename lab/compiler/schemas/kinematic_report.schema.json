{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/kinematic-report/1.0",
  "type": "object",
  "required": ["schema", "policy", "status", "findings"],
  "properties": {
    "schema": {"const": "cpcs.kinematic_report/1.0"},
    "policy": {"const": "cpcs-kinematics/1.0"},
    "status": {"enum": ["pass", "fail"]},
    "findings": {"type": "array", "items": {
      "type": "object", "required": ["code", "t", "subject", "message"],
      "properties": {
        "code": {"enum": ["FRAME_UNDECLARED", "FORCE_EVENT_UNKNOWN", "TIME_ORDER", "TELEPORT", "SPEED_JUMP", "SUPPORT_UNDECLARED",
          "SUPPORT_GAP", "SUPPORT_UNKNOWN", "FLIGHT_BOUNDS", "SUPPORT_HEIGHT", "CONSTRAINT_CONTRADICTION", "CONTACT_MODE_UNKNOWN",
          "REACH", "SWING_EXTENT", "RELEASE", "CAMERA_YAW_ONLY", "CAMERA_AIM", "DENSITY"]},
        "t": {"type": ["number", "null"]}, "subject": {"type": ["string", "null"]}, "message": {"type": "string", "minLength": 1}},
      "additionalProperties": false}}
  },
  "additionalProperties": false
}
