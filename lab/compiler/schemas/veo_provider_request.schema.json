{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/google-vertex-ai/veo-provider-request/1.0",
  "type": "object",
  "required": ["method", "url", "body"],
  "properties": {
    "method": {"const": "POST"},
    "url": {"type": "string", "pattern": "^https://[a-z0-9-]+-aiplatform\\.googleapis\\.com/v1/projects/[a-z][a-z0-9-]+/locations/[a-z0-9-]+/publishers/google/models/veo-3\\.1-generate-001:predictLongRunning$"},
    "body": {
      "type": "object", "required": ["instances", "parameters"],
      "properties": {
        "instances": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "required": ["prompt"],
            "properties": {
              "prompt": {"type": "string", "minLength": 1},
              "image": {"$ref": "#/$defs/image"},
              "lastFrame": {"$ref": "#/$defs/image"}
            }, "additionalProperties": false
          }
        },
        "parameters": {
          "type": "object",
          "required": ["aspectRatio", "durationSeconds", "enhancePrompt", "personGeneration", "resolution", "sampleCount", "seed"],
          "properties": {
            "aspectRatio": {"enum": ["16:9", "9:16"]},
            "durationSeconds": {"enum": [4, 6, 8]},
            "enhancePrompt": {"const": false},
            "personGeneration": {"enum": ["allow_adult", "disallow"]},
            "resolution": {"enum": ["720p", "1080p"]},
            "sampleCount": {"type": "integer", "minimum": 1, "maximum": 4},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "storageUri": {"type": "string", "pattern": "^gs://[^/]+(?:/.*)?$"}
          }, "additionalProperties": false
        }
      }, "additionalProperties": false
    }
  }, "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object", "required": ["gcsUri", "mimeType"],
      "properties": {
        "gcsUri": {"type": "string", "pattern": "^gs://[^/]+/.+$"},
        "mimeType": {"enum": ["image/jpeg", "image/png"]}
      }, "additionalProperties": false
    }
  }
}
