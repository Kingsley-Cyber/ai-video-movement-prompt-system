{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/profile/1.0",
  "type": "object",
  "required": [
    "schema",
    "profile_id",
    "profile_kind",
    "extends",
    "priority",
    "required_layers",
    "defaults",
    "control_contributions",
    "constraints",
    "conflicts",
    "preferred_workflows",
    "verification_metrics"
  ],
  "properties": {
    "schema": {"const": "cpcs.profile/1.0"},
    "profile_id": {
      "type": "string",
      "pattern": "^profile://[A-Za-z0-9._/-]+/1\\.0$"
    },
    "profile_kind": {"enum": ["universal", "domain"]},
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
    },
    "priority": {"type": "integer", "minimum": 0},
    "activation_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "component_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
    },
    "required_layers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "defaults": {"type": "object"},
    "field_policies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "replace",
          "merge_object",
          "merge_by_id",
          "append_ordered",
          "union_set",
          "intersect_set",
          "minimum",
          "maximum",
          "compose_temporal_tracks",
          "reject_on_conflict"
        ]
      }
    },
    "control_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "path", "value", "source_refs"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^control_[A-Za-z0-9._-]+$"},
          "path": {"type": "string", "minLength": 1},
          "value": {},
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "kind", "text", "source_refs"],
        "properties": {
          "constraint_id": {"type": "string", "pattern": "^constraint_[A-Za-z0-9._-]+$"},
          "kind": {"enum": ["hard_lock", "invariant", "safety", "soft"]},
          "text": {"type": "string", "minLength": 1},
          "path": {"type": ["string", "null"]},
          "value": {},
          "source_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflict_id", "profiles", "field", "options", "outcome", "reason"],
        "properties": {
          "conflict_id": {"type": "string", "pattern": "^conflict_[A-Za-z0-9._-]+$"},
          "profiles": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
          },
          "field": {"type": "string", "minLength": 1},
          "options": {"type": "array", "minItems": 2, "uniqueItems": true},
          "outcome": {
            "enum": [
              "resolved_by_precedence",
              "resolved_by_compatibility_rule",
              "requires_user_choice",
              "unsupported_combination",
              "deferred_to_provider_compiler"
            ]
          },
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "preferred_workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id", "target_paths", "method", "observability"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^metric_[A-Za-z0-9._-]+$"},
          "target_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "method": {"type": "string", "minLength": 1},
          "observability": {"enum": ["direct", "semantic", "measured", "human_review"]}
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile_kind": {"const": "universal"}}},
      "then": {"required": ["field_policies"]}
    },
    {
      "if": {"properties": {"profile_kind": {"const": "domain"}}},
      "then": {"required": ["activation_labels", "component_profiles"]}
    }
  ],
  "additionalProperties": false
}
