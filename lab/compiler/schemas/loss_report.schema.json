{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/loss-report/1.0",
  "type": "object",
  "required": ["schema", "score_id", "losses", "has_unsupported_controls", "provider_limitations"],
  "properties": {
    "schema": {"const": "cpcs.loss_report/1.0"},
    "score_id": {"type": "string", "pattern": "^score_[0-9a-f]{32}$"},
    "losses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["control_id", "path", "loss_type", "severity", "reason"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
          "path": {"type": "string", "minLength": 1},
          "loss_type": {"enum": ["omitted_decision", "compression", "evaluation_only", "unsupported", "withheld_default"]},
          "severity": {"enum": ["none", "low", "high"]},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "has_unsupported_controls": {"type": "boolean"},
    "provider_limitations": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
