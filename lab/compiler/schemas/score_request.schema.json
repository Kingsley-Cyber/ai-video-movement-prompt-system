{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/score-request/1.0",
  "type": "object",
  "required": [
    "schema",
    "normalized_intent",
    "context_bundle",
    "profile_selection",
    "overlays",
    "conflict_resolutions",
    "assets"
  ],
  "properties": {
    "schema": {"const": "cpcs.score_request/1.0"},
    "normalized_intent": {"type": "object"},
    "context_bundle": {"type": "object"},
    "directing_strategy": {"type": "object"},
    "knowledge_lens": {"type": "object"},
    "requested_reasoning_policy_id": {"type": "string", "pattern": "^rp_[A-Za-z0-9._-]+$"},
    "profile_selection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["overlay_id", "scope", "priority", "values", "locks"],
        "properties": {
          "overlay_id": {"type": "string", "pattern": "^overlay_[A-Za-z0-9._-]+$"},
          "scope": {
            "enum": [
              "user_defaults",
              "project_profile",
              "scene_override",
              "shot_override",
              "event_lock",
              "explicit_user_correction"
            ]
          },
          "priority": {"type": "integer", "minimum": 0},
          "values": {"type": "object", "minProperties": 1},
          "locks": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "conflict_resolutions": {
      "type": "object",
      "additionalProperties": {}
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "role", "content_hash", "rights_basis"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9._-]+$"},
          "role": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "rights_basis": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
