{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/universal-score/1.0",
  "type": "object",
  "required": [
    "schema_version",
    "score_id",
    "score_status",
    "normalized_intent",
    "profile_resolution",
    "project",
    "entities",
    "scenes",
    "shots",
    "beats",
    "actions",
    "performance",
    "motion",
    "interactions",
    "camera",
    "editing",
    "audio",
    "marketing",
    "style",
    "continuity",
    "assets",
    "constraints",
    "provider_neutral_controls",
    "provider_realization",
    "verification_requirements",
    "provenance",
    "unresolved",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "cpcs.universal_score/1.0"},
    "score_id": {"type": "string", "pattern": "^score_[0-9a-f]{32}$"},
    "score_status": {"enum": ["ready", "needs_input"]},
    "normalized_intent": {
      "type": "object",
      "required": ["schema"],
      "properties": {"schema": {"const": "cpcs.normalized_intent/1.0"}}
    },
    "profile_resolution": {"$ref": "#/$defs/profileResolution"},
    "project": {"type": "object"},
    "entities": {"type": "array", "items": {"type": "object"}},
    "scenes": {"type": "array", "items": {"type": "object"}},
    "shots": {"type": "array", "items": {"type": "object"}},
    "beats": {"type": "array", "items": {"type": "object"}},
    "actions": {"type": "array", "items": {"type": "object"}},
    "performance": {"type": "object"},
    "motion": {"type": "object"},
    "interactions": {"type": "array", "items": {"type": "object"}},
    "camera": {"type": "object"},
    "editing": {"type": "object"},
    "audio": {"type": "object"},
    "marketing": {"type": "object"},
    "style": {"type": "object"},
    "continuity": {"type": "object"},
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "constraints": {"$ref": "#/$defs/constraints"},
    "provider_neutral_controls": {
      "type": "array",
      "items": {"$ref": "#/$defs/control"}
    },
    "provider_realization": {
      "type": "object",
      "required": ["status", "capability_dispositions"],
      "properties": {
        "status": {"const": "unassigned"},
        "capability_dispositions": {"type": "array", "maxItems": 0}
      },
      "additionalProperties": false
    },
    "verification_requirements": {
      "type": "array",
      "items": {"$ref": "#/$defs/verificationRequirement"}
    },
    "provenance": {"$ref": "#/$defs/provenance"},
    "unresolved": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/warning"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "appliedProfile": {
      "type": "object",
      "required": ["profile_id", "profile_kind", "priority", "content_hash", "component_of"],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"},
        "profile_kind": {"enum": ["universal", "domain", "component"]},
        "priority": {"type": "integer", "minimum": 0},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "component_of": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
        }
      },
      "additionalProperties": false
    },
    "profileConflict": {
      "type": "object",
      "required": ["conflict_id", "profiles", "field", "options", "outcome", "selected", "reason"],
      "properties": {
        "conflict_id": {"type": "string", "pattern": "^conflict_[A-Za-z0-9._-]+$"},
        "profiles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
        },
        "field": {"type": "string", "minLength": 1},
        "options": {"type": "array", "minItems": 2, "uniqueItems": true},
        "outcome": {
          "enum": [
            "resolved_by_precedence",
            "resolved_by_compatibility_rule",
            "requires_user_choice",
            "unsupported_combination",
            "deferred_to_provider_compiler"
          ]
        },
        "selected": {},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "profileResolution": {
      "type": "object",
      "required": [
        "kernel_profile",
        "requested_labels",
        "applied_profiles",
        "required_layers",
        "preferred_workflows",
        "merge_policy",
        "conflicts"
      ],
      "properties": {
        "kernel_profile": {"const": "profile://universal/video/1.0"},
        "requested_labels": {"$ref": "#/$defs/uniqueStrings"},
        "applied_profiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/appliedProfile"}
        },
        "required_layers": {"$ref": "#/$defs/uniqueStrings"},
        "preferred_workflows": {"$ref": "#/$defs/uniqueStrings"},
        "merge_policy": {"const": "cpcs-typed-merge/1.0"},
        "conflicts": {
          "type": "array",
          "items": {"$ref": "#/$defs/profileConflict"}
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "role", "content_hash", "rights_basis"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^asset_[A-Za-z0-9._-]+$"},
        "role": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "rights_basis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "appliedConstraint": {
      "type": "object",
      "required": ["constraint_id", "kind", "text", "path", "value", "source_refs"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["hard_lock", "invariant", "safety", "soft", "authored"]},
        "text": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "value": {},
        "source_refs": {"$ref": "#/$defs/uniqueStrings"}
      },
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "required": ["hard", "soft", "continuity_locks", "applied", "locked_paths"],
      "properties": {
        "hard": {"$ref": "#/$defs/uniqueStrings"},
        "soft": {"$ref": "#/$defs/uniqueStrings"},
        "continuity_locks": {"$ref": "#/$defs/uniqueStrings"},
        "applied": {"type": "array", "items": {"$ref": "#/$defs/appliedConstraint"}},
        "locked_paths": {"$ref": "#/$defs/uniqueStrings"}
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["control_id", "path", "value", "authority", "provenance_ref"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "value": {},
        "authority": {"const": "canonical_score"},
        "provenance_ref": {"type": "string", "pattern": "^provenance\\.fields\\.[A-Za-z0-9._-]+$"}
      },
      "additionalProperties": false
    },
    "verificationRequirement": {
      "type": "object",
      "required": ["metric_id", "target_paths", "method", "observability", "source_profile"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^metric_[A-Za-z0-9._-]+$"},
        "target_paths": {"$ref": "#/$defs/uniqueStrings"},
        "method": {"type": "string", "minLength": 1},
        "observability": {"enum": ["direct", "semantic", "measured", "human_review"]},
        "source_profile": {"type": "string", "pattern": "^profile://[A-Za-z0-9._/-]+$"}
      },
      "additionalProperties": false
    },
    "fieldCandidate": {
      "type": "object",
      "required": ["source", "scope", "priority", "value", "source_refs"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "priority": {"type": "integer", "minimum": 0},
        "value": {},
        "source_refs": {"$ref": "#/$defs/uniqueStrings"}
      },
      "additionalProperties": false
    },
    "fieldProvenance": {
      "type": "object",
      "required": ["value", "winner", "candidates", "merge_operator", "reason", "source_refs"],
      "properties": {
        "value": {},
        "winner": {"type": ["string", "null"]},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/fieldCandidate"}},
        "merge_operator": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/uniqueStrings"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "resolver_version",
        "request_hash",
        "intent_hash",
        "context_hash",
        "profile_hashes",
        "concept_ids",
        "fields"
      ],
      "properties": {
        "resolver_version": {"const": "cpcs-score-resolver/1.0"},
        "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "intent_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "context_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile_hashes": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}
        },
        "fields": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/fieldProvenance"}
        }
      },
      "additionalProperties": false
    },
    "unresolved": {
      "type": "object",
      "required": ["code", "id", "path", "message", "options"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1},
        "options": {"type": "array", "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
