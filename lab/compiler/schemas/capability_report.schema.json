{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://compiler/capability-report/1.0",
  "type": "object",
  "required": [
    "schema", "capability_id", "provider", "model", "prompt_budget_chars",
    "prompt_chars_used", "reference_prompt_budget_chars", "reference_prompt_chars_used",
    "reference_projection_control_ids", "reference_projection_omissions", "creative_policy",
    "dispositions", "limitations"
  ],
  "properties": {
    "schema": {"const": "cpcs.capability_report/1.0"},
    "movement_reports": {"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","path","message"],"properties":{"code":{"const":"SPACING_UNIFORM"},"path":{"type":"string"},"message":{"type":"string"}}}},
    "projection_audit": {"$ref": "#/$defs/projectionAudit"},
    "timing_projection": {
      "type": "object",
      "required": ["kind", "provider_adherence_claim", "carrier", "layout", "printed_form", "schedule_status", "planned"],
      "properties": {
        "kind": {"const": "carrier_choice"},
        "provider_adherence_claim": {"const": false},
        "carrier": {"enum": ["canonical", "prose", "json"]},
        "layout": {"enum": ["default", "labelled_skeleton_v1"]},
        "printed_form": {"enum": ["timestamps", "lengths", "minimums", "order_only", "none"]},
        "schedule_status": {"enum": ["resolved", "unresolved"]},
        "planned": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "capability_id": {"type": "string", "pattern": "^provider-capability://[A-Za-z0-9._/-]+$"},
    "provider": {"enum": ["google_vertex_ai", "byteplus_seedance"]},
    "model": {"enum": ["veo-3.1-generate-001", "seedance-2.0"]},
    "prompt_budget_chars": {"type": ["integer", "null"], "minimum": 1},
    "prompt_chars_used": {"type": "integer", "minimum": 1},
    "reference_prompt_budget_chars": {"type": ["integer", "null"], "minimum": 1},
    "reference_prompt_chars_used": {"type": "integer", "minimum": 1},
    "reference_projection_control_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"}
    },
    "reference_projection_omissions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["control_id", "path", "reason"],
        "properties": {
          "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "creative_policy": {"$ref": "#/$defs/creativePolicy"},
    "dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/disposition"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "projectionAudit": {
      "type": "object",
      "properties": {
        "closed_code": {"type":"object","additionalProperties":false,"required":["bytes","kind","members","model_efficacy_claim"],"properties":{"bytes":{"type":"integer","minimum":0},"kind":{"const":"subset_of_typed_bound"},"members":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"model_efficacy_claim":{"const":false}}},
        "layout": {
          "const": "labelled_skeleton_v1"
        },
        "byte_counts": {
          "type": "object",
          "properties": {
            "typed_bound": {
              "type": "integer",
              "minimum": 0
            },
            "authored_clause": {
              "type": "integer",
              "minimum": 0
            },
            "layout": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "typed_bound",
            "authored_clause",
            "layout"
          ],
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "fully_bound",
                  "partly_bound",
                  "authored_only"
                ]
              }
            },
            "required": [
              "ref",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "authored_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object": {
                "type": "string",
                "minLength": 1
              },
              "hand": {
                "enum": [
                  "left",
                  "right"
                ]
              },
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "const": "authored"
              },
              "source_explicit": {
                "const": false
              }
            },
            "required": [
              "object",
              "hand",
              "class",
              "source_explicit"
            ],
            "additionalProperties": false
          }
        },
        "camera_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "shot": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "enum": [
                  "lens",
                  "focus",
                  "angle",
                  "movement"
                ]
              },
              "disposition": {
                "const": "source_unspecified"
              }
            },
            "required": [
              "shot",
              "field",
              "disposition"
            ],
            "additionalProperties": false
          }
        },
        "beat_timing": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "carrier_choice"
            },
            "provider_adherence_claim": {
              "const": false
            },
            "beats": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "beat": {
                    "type": "string",
                    "minLength": 1
                  },
                  "duration_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "start_s": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end_s": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "beat",
                  "duration_s",
                  "start_s",
                  "end_s"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "provider_adherence_claim",
            "beats"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "layout",
        "byte_counts",
        "fields",
        "authored_bindings",
        "camera_dispositions",
        "beat_timing",
        "source"
      ],
      "additionalProperties": false
    },
    "creativePolicy": {
      "type": "object",
      "required": ["policy_version", "mode", "hard_invariants", "decisions"],
      "properties": {
        "policy_version": {"const": "cpcs-creative-policy/1.0"},
        "mode": {"enum": ["exact", "interpretive", "exploratory", "transfer", "diagnostic", "research_gap"]},
        "hard_invariants": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decisions": {
          "type": "array", "minItems": 3,
          "items": {
            "type": "object", "required": ["decision_id", "outcome", "reason"],
            "properties": {
              "decision_id": {"enum": ["creative_mode", "sample_count", "seed"]},
              "outcome": {},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": ["control_id", "path", "status", "carrier", "reason"],
      "properties": {
        "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
        "path": {"type": "string", "minLength": 1},
        "status": {
          "enum": [
            "native", "approximated", "reference_baked", "control_media",
            "compressed_to_text", "postproduction", "evaluation_only", "unsupported"
          ]
        },
        "carrier": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
