{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://release/evaluator-stability-request/1.0",
  "type": "object",
  "required": ["schema", "suite_id", "suite_manifest_hash", "reference_evaluator", "candidate_evaluator", "optimization", "thresholds", "calibration_cases", "heldout_cases"],
  "properties": {
    "schema": {"const": "cpcs.evaluator_stability_request/1.0"},
    "suite_id": {"type": "string", "pattern": "^suite_[A-Za-z0-9._-]{3,80}$"},
    "suite_manifest_hash": {"$ref": "#/$defs/hash"},
    "reference_evaluator": {"$ref": "#/$defs/evaluator"},
    "candidate_evaluator": {"$ref": "#/$defs/evaluator"},
    "optimization": {
      "type": "object",
      "required": ["candidate_optimized_against_evaluator_hash", "manifest_hash", "case_ids"],
      "properties": {
        "candidate_optimized_against_evaluator_hash": {"$ref": "#/$defs/hash"},
        "manifest_hash": {"$ref": "#/$defs/hash"},
        "case_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/case_id"}}
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["max_candidate_mae", "max_case_drift", "max_mae_regression", "max_delta_gap", "min_evaluator_gain_for_collapse", "min_human_regression_for_collapse", "max_sign_disagreements"],
      "properties": {
        "max_candidate_mae": {"$ref": "#/$defs/unit"},
        "max_case_drift": {"$ref": "#/$defs/unit"},
        "max_mae_regression": {"type": "number", "minimum": -1, "maximum": 1},
        "max_delta_gap": {"$ref": "#/$defs/unit"},
        "min_evaluator_gain_for_collapse": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "min_human_regression_for_collapse": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_sign_disagreements": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "calibration_cases": {"type": "array", "minItems": 3, "maxItems": 10000, "items": {"$ref": "#/$defs/calibration_case"}},
    "heldout_cases": {"type": "array", "minItems": 3, "maxItems": 10000, "items": {"$ref": "#/$defs/heldout_case"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case_id": {"type": "string", "pattern": "^case_[A-Za-z0-9._-]{3,80}$"},
    "unit": {"type": "number", "minimum": 0, "maximum": 1},
    "evaluator": {
      "type": "object",
      "required": ["evaluator_id", "model", "version", "prompt_hash", "response_schema_hash"],
      "properties": {
        "evaluator_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "model": {"type": "string", "minLength": 1, "maxLength": 200},
        "version": {"type": "string", "minLength": 1, "maxLength": 200},
        "prompt_hash": {"$ref": "#/$defs/hash"},
        "response_schema_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["score", "evidence_ref", "evidence_hash", "evidence_class"],
      "properties": {
        "score": {"$ref": "#/$defs/unit"},
        "evidence_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
        "evidence_hash": {"$ref": "#/$defs/hash"},
        "evidence_class": {"enum": ["human_review", "interpreted"]}
      },
      "additionalProperties": false
    },
    "calibration_case": {
      "type": "object",
      "required": ["case_id", "artifact_id", "artifact_hash", "human", "reference_evaluator", "candidate_evaluator"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "artifact_hash": {"$ref": "#/$defs/hash"},
        "human": {"$ref": "#/$defs/score"},
        "reference_evaluator": {"$ref": "#/$defs/score"},
        "candidate_evaluator": {"$ref": "#/$defs/score"}
      },
      "additionalProperties": false
    },
    "heldout_case": {
      "type": "object",
      "required": ["case_id", "baseline_artifact_id", "baseline_artifact_hash", "candidate_artifact_id", "candidate_artifact_hash", "human_baseline", "human_candidate", "evaluator_baseline", "evaluator_candidate"],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "baseline_artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "baseline_artifact_hash": {"$ref": "#/$defs/hash"},
        "candidate_artifact_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "candidate_artifact_hash": {"$ref": "#/$defs/hash"},
        "human_baseline": {"$ref": "#/$defs/score"},
        "human_candidate": {"$ref": "#/$defs/score"},
        "evaluator_baseline": {"$ref": "#/$defs/score"},
        "evaluator_candidate": {"$ref": "#/$defs/score"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
