{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://release/external-qualification-evidence/2.0",
  "type": "object",
  "required": [
    "schema",
    "source_revision",
    "evaluator_id",
    "gates",
    "attestation"
  ],
  "properties": {
    "schema": {"const": "cpcs.external_qualification_evidence/2.0"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "evaluator_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "closed_world_annotation",
          "calibration",
          "held_out",
          "provider",
          "graph_write_promotion"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "evaluated_at",
          "artifacts",
          "metrics",
          "summary"
        ],
        "properties": {
          "status": {"enum": ["passed", "failed"]},
          "evaluated_at": {"type": "string", "format": "date-time"},
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "size_bytes"],
              "properties": {
                "path": {"type": "string", "minLength": 1, "maxLength": 512},
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "size_bytes": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            }
          },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 128,
            "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
            "additionalProperties": {
              "oneOf": [
                {"type": "number"},
                {"type": "boolean"},
                {"type": "string", "minLength": 1, "maxLength": 500}
              ]
            }
          },
          "summary": {"type": "string", "minLength": 1, "maxLength": 2000}
        },
        "additionalProperties": false
      }
    },
    "attestation": {
      "type": "object",
      "required": ["algorithm", "mac"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "mac": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
