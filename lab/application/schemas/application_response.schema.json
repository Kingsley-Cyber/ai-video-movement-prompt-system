{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://application/response/1.0",
  "type": "object",
  "required": ["schema", "request_id", "operation", "status", "authority", "policy_versions", "result", "error"],
  "properties": {
    "schema": {"const": "cpcs.application_response/1.0"},
    "request_id": {"type": "string", "pattern": "^app_[0-9a-f]{24}$"},
    "operation": {"type": "string", "pattern": "^cpcs\\.[a-z][a-z0-9_.]*$"},
    "status": {"enum": ["success", "error"]},
    "authority": {
      "type": "object",
      "required": ["required_role", "granted_role", "mutation_scope", "authorization_required"],
      "properties": {
        "required_role": {"enum": ["chat", "operator", "curator"]},
        "granted_role": {"enum": ["chat", "operator", "curator"]},
        "mutation_scope": {
          "type": ["string", "null"],
          "enum": [null, "staging", "curated", "immutable", "derived", "immutable_and_derived", "operational", "operational_external", "operational_external_immutable"]
        },
        "authorization_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "policy_versions": {
      "type": "object",
      "required": ["application", "authorization"],
      "properties": {
        "application": {"const": "cpcs-application/1.27"},
        "authorization": {"const": "cpcs-local-authority/1.1"}
      },
      "additionalProperties": {"type": "string"}
    },
    "result": {"type": ["object", "null"]},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": "object"}
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}},
      "then": {
        "properties": {
          "result": {"type": "object"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "result": {"type": "null"},
          "error": {"type": "object"}
        }
      }
    }
  ],
  "additionalProperties": false
}
