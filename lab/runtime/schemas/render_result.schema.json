{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://runtime/render-result/1.0",
  "type": "object",
  "required": ["schema", "job_id", "build_id", "build_hash", "provider", "model", "operation_id", "status", "artifacts", "expected_media", "provider_response_hash", "completed_at"],
  "properties": {
    "schema": {"const": "cpcs.render_result/1.0"},
    "job_id": {"type": "string", "pattern": "^render_job_[0-9a-f]{24}$"},
    "build_id": {"type": "string", "pattern": "^build_[0-9a-f]{32}$"},
    "build_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "status": {"const": "succeeded"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "relative_path", "source_uri", "mime_type", "size_bytes", "sha256"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^artifact_[0-9]{3}$"},
          "relative_path": {"type": "string", "pattern": "^artifacts/artifact_[0-9]{3}\\.mp4$"},
          "source_uri": {"type": ["string", "null"]},
          "mime_type": {"const": "video/mp4"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "expected_media": {
      "type": "object",
      "required": ["duration_seconds", "aspect_ratio", "resolution", "sample_count"],
      "properties": {
        "duration_seconds": {"type": "integer", "minimum": 1},
        "aspect_ratio": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "provider_response_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
