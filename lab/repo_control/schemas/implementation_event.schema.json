{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpcs.local/schemas/implementation_event/1.0",
  "title": "CPCS Implementation Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "work_id", "requirement_id", "event_type", "occurred_at", "actor", "summary", "branch", "revision", "files", "verifications", "parent_event_hash", "event_hash"],
  "properties": {
    "schema": {"const": "cpcs.implementation_event/1.0"},
    "id": {"type": "string", "pattern": "^workevt_[0-9a-f]{20}$"},
    "work_id": {"type": "string", "pattern": "^work_[a-z0-9][a-z0-9_-]{2,79}$"},
    "requirement_id": {"type": "string", "pattern": "^REQ-[0-9]{3}$"},
    "event_type": {"enum": ["admitted", "started", "checkpoint", "verification", "blocked", "completed", "abandoned"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "branch": {"type": "string", "minLength": 1},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "files": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "output_sha256"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer"},
          "output_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "parent_event_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
    "event_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
