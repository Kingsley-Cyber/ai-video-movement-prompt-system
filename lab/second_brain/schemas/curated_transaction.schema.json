{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpcs.local/schemas/curated_transaction.schema.json",
  "title": "CPCS Curated Transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transaction_id",
    "transaction_hash",
    "nonce",
    "operation",
    "operation_id",
    "created_at",
    "state",
    "targets"
  ],
  "properties": {
    "schema": {"const": "cpcs.curated_transaction/1.0"},
    "transaction_id": {"type": "string", "pattern": "^curation_tx_[0-9a-f]{24}$"},
    "transaction_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "operation": {
      "enum": ["promote_proposal", "promote_distillation_bundle", "consolidate_reciprocal_edges"]
    },
    "operation_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["prepared", "committed", "recovered_rollback"]},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "before", "after"],
        "properties": {
          "path": {
            "enum": [
              "lab/concepts.jsonl",
              "lab/second_brain/curated/edges.jsonl",
              "lab/second_brain/curated/rules.jsonl",
              "lab/second_brain/curated/intents.jsonl",
              "lab/second_brain/curated/mappings.jsonl"
            ]
          },
          "mode": {"type": "integer", "minimum": 0, "maximum": 511},
          "before": {"$ref": "#/$defs/blob"},
          "after": {"$ref": "#/$defs/blob"}
        }
      }
    }
  },
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blob", "size_bytes", "sha256"],
      "properties": {
        "blob": {"type": "string", "pattern": "^(before|after)/[0-9]{3}\\.bin$"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
