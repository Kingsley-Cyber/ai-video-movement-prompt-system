{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/research-delta-patch-receipt/1.0",
  "type": "object",
  "required": [
    "schema", "execution_id", "delta_id", "proposal_id", "request_hash",
    "plan_hash", "baseline_revision", "patch_sha256", "patch_paths",
    "staged_diff_hash", "file_hashes", "status", "failure", "commands",
    "authority", "receipt_hash"
  ],
  "properties": {
    "schema": {"const": "cpcs.research_delta_patch_receipt/1.0"},
    "execution_id": {"type": "string", "pattern": "^research_patch_[0-9a-f]{24}$"},
    "delta_id": {"type": "string", "pattern": "^research_delta_[0-9a-f]{24}$"},
    "proposal_id": {"type": "string", "pattern": "^implementation_proposal_[0-9a-f]{24}$"},
    "request_hash": {"$ref": "#/$defs/hash"},
    "plan_hash": {"$ref": "#/$defs/hash"},
    "baseline_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "patch_sha256": {"$ref": "#/$defs/hash"},
    "patch_paths": {"$ref": "#/$defs/paths"},
    "staged_diff_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "file_hashes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["path", "content_hash"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
          "content_hash": {"$ref": "#/$defs/hash"}
        },
        "additionalProperties": false
      }
    },
    "status": {"enum": ["passed", "failed"]},
    "failure": {"type": ["string", "null"]},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/commandResult"}},
    "authority": {
      "type": "object",
      "required": ["worktree", "live_checkout", "curated", "immutable", "merge", "push", "promotion"],
      "properties": {
        "worktree": {"const": "isolated_detached_operational"},
        "live_checkout": {"const": "unchanged"},
        "curated": {"const": "unchanged"},
        "immutable": {"const": "unchanged"},
        "merge": {"const": "not_performed"},
        "push": {"const": "not_performed"},
        "promotion": {"const": "not_performed"}
      },
      "additionalProperties": false
    },
    "receipt_hash": {"$ref": "#/$defs/hash"}
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"}
    },
    "commandResult": {
      "type": "object",
      "required": ["index", "argv", "exit_code", "stdout_hash", "stderr_hash"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exit_code": {"type": "integer"},
        "stdout_hash": {"$ref": "#/$defs/hash"},
        "stderr_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    }
  }
}
