{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/context-bundle/1.1",
  "type": "object",
  "required": [
    "schema",
    "request",
    "selected_concepts",
    "typed_paths",
    "mappings",
    "knowledge_objects",
    "curated_evidence",
    "external_evidence",
    "conflicts",
    "rejections",
    "knowledge_gap",
    "temporal",
    "budget_report",
    "trust_boundary",
    "policy_versions"
  ],
  "properties": {
    "schema": {"const": "cpcs.context_bundle/1.1"},
    "request": {"$ref": "#/$defs/request"},
    "selected_concepts": {
      "type": "array",
      "items": {"$ref": "#/$defs/selectedConcept"}
    },
    "typed_paths": {
      "type": "array",
      "items": {"$ref": "#/$defs/typedPath"}
    },
    "mappings": {
      "type": "array",
      "items": {"$ref": "#/$defs/mapping"}
    },
    "knowledge_objects": {
      "type": "array",
      "items": {"$ref": "#/$defs/knowledgeObject"}
    },
    "curated_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/curatedEvidence"}
    },
    "external_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/externalEvidence"}
    },
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "rejections": {
      "type": "array",
      "items": {"$ref": "#/$defs/rejection"}
    },
    "knowledge_gap": {"$ref": "#/$defs/knowledgeGap"},
    "temporal": {"$ref": "#/$defs/temporal"},
    "budget_report": {"$ref": "#/$defs/budgetReport"},
    "trust_boundary": {"$ref": "#/$defs/trustBoundary"},
    "policy_versions": {"$ref": "#/$defs/policyVersions"}
  },
  "additionalProperties": false,
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "query",
        "intent",
        "token_budget",
        "provider",
        "model",
        "domain",
        "target_format",
        "minimum_status",
        "include_external_evidence",
        "as_of",
        "validity_mode"
      ],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "intent": {"type": ["string", "null"]},
        "token_budget": {"type": "integer", "minimum": 1},
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "domain": {"type": ["string", "null"]},
        "target_format": {"enum": ["prose", "natural_language", "yaml", "json", "xml", "hybrid"]},
        "minimum_status": {"enum": ["ingested", "partial", "proven"]},
        "include_external_evidence": {"type": "boolean"},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "validity_mode": {"enum": ["current", "historical", "all_versions"]}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"validity_mode": {"const": "historical"}}},
          "then": {"properties": {"as_of": {"type": "string", "format": "date-time"}}},
          "else": {"properties": {"as_of": {"type": "null"}}}
        }
      ]
    },
    "selectedConcept": {
      "type": "object",
      "required": [
        "id",
        "name",
        "layer",
        "status",
        "depth",
        "admission_reason",
        "required_by",
        "path",
        "covered_terms",
        "policy_version",
        "trust_class"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"},
        "name": {"type": ["string", "null"]},
        "layer": {"type": ["string", "null"]},
        "status": {"enum": ["unexplored", "ingested", "partial", "proven", "deprecated"]},
        "depth": {"type": "integer", "minimum": 0},
        "admission_reason": {"enum": ["direct_match", "required_prerequisite", "operational_bridge", "structural_term_support"]},
        "required_by": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "path": {"type": "array", "items": {"type": "string"}},
        "covered_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "policy_version": {"type": "string", "minLength": 1},
        "trust_class": {"const": "curated_repository_authority"}
      },
      "additionalProperties": false
    },
    "typedPath": {
      "type": "object",
      "required": [
        "from",
        "to",
        "edge_id",
        "edge_type",
        "tier",
        "depth",
        "direction",
        "transition",
        "family",
        "policy_version",
        "path_kind",
        "trust_class"
      ],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "edge_id": {"type": "string", "minLength": 1},
        "edge_type": {"type": ["string", "null"]},
        "tier": {"type": ["string", "null"]},
        "depth": {"type": "integer", "minimum": 0},
        "direction": {"type": ["string", "null"]},
        "transition": {"type": ["string", "null"]},
        "family": {"type": ["string", "null"]},
        "policy_version": {"type": "string", "minLength": 1},
        "path_kind": {"const": "selected"},
        "trust_class": {"enum": ["ephemeral_query_decision", "curated_repository_authority", "immutable_evidence", "derived_non_authoritative"]}
      },
      "additionalProperties": false
    },
    "mapping": {
      "type": "object",
      "required": ["id", "concept_id", "target_type", "target_id", "encoding", "mapping", "loss", "sources", "trust_class"],
      "properties": {
        "id": {"type": "string", "pattern": "^mapping_[A-Za-z0-9._-]+$"},
        "concept_id": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"},
        "target_type": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "encoding": {"enum": ["prose", "natural_language", "yaml", "json", "xml", "numeric", "asset", "hybrid"]},
        "mapping": {"type": "object", "minProperties": 1},
        "representation_strategy": {"$ref": "#/$defs/representationStrategy"},
        "loss": {"enum": ["none", "low", "medium", "high"]},
        "provider": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "provenance": {"type": "object"},
        "validity": {"$ref": "#/$defs/validity"},
        "trust_class": {"const": "curated_repository_authority"}
      },
      "additionalProperties": false
    },
    "representationStrategy": {
      "type": "object",
      "required": ["semantic_authority", "projections"],
      "properties": {
        "semantic_authority": {"const": "canonical_json_score"},
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/formatProjection"}
        }
      },
      "additionalProperties": false
    },
    "formatProjection": {
      "type": "object",
      "required": ["format", "roles", "expresses", "template", "loss", "limitations", "conditioning_effects"],
      "properties": {
        "format": {"enum": ["natural_language", "yaml", "json", "xml"]},
        "roles": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["qualitative_direction", "human_authoring", "typed_parameters", "ordered_mixed_content", "hierarchy", "event_triggers", "provider_conditioning", "verification"]}
        },
        "expresses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "template": {"type": "string", "minLength": 1, "maxLength": 12000},
        "loss": {"enum": ["none", "low", "medium", "high"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conditioning_effects": {"type": "array", "items": {"$ref": "#/$defs/conditioningEffect"}}
      },
      "additionalProperties": false
    },
    "conditioningEffect": {
      "type": "object",
      "required": ["claim", "effect_type", "direction", "epistemic_class", "evidence_status", "confidence", "confidence_basis", "scope", "evidence_refs", "limitations"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "effect_type": {"type": "string", "minLength": 1},
        "direction": {"enum": ["positive", "negative", "neutral", "mixed", "unknown"]},
        "epistemic_class": {"enum": ["measured", "detected", "inferred", "interpreted", "authored", "simulated", "derived"]},
        "evidence_status": {"enum": ["unverified", "supported", "contradicted", "qualified", "deprecated"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_basis": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "required": ["provider", "model_version", "task_class", "duration_seconds", "prompt_budget_chars"],
          "properties": {
            "provider": {"type": ["string", "null"], "minLength": 1},
            "model_version": {"type": ["string", "null"], "minLength": 1},
            "task_class": {"type": ["string", "null"], "minLength": 1},
            "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
            "prompt_budget_chars": {"type": ["integer", "null"], "minimum": 1}
          },
          "additionalProperties": false
        },
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"evidence_status": {"const": "qualified"}}},
          "then": {
            "properties": {
              "scope": {"properties": {"provider": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1}, "task_class": {"type": "string", "minLength": 1}}},
              "evidence_refs": {"minItems": 1}
            }
          }
        }
      ]
    },
    "curatedEvidence": {
      "type": "object",
      "required": ["id", "evidence_kind", "reference", "concept_ids", "trust_class"],
      "properties": {
        "id": {"type": "string", "pattern": "^evidence:[0-9a-f]{16}$"},
        "evidence_kind": {"enum": ["source_reference", "repository_evidence_id"]},
        "reference": {"type": "string", "minLength": 1},
        "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
        "trust_class": {"enum": ["curated_lineage_reference", "derived_lineage_reference"]}
      },
      "additionalProperties": false
    },
    "knowledgeObject": {
      "type": "object",
      "required": ["object_type", "object_id", "concept_ids", "matched_concept_ids", "record", "trust_class"],
      "properties": {
        "object_type": {"enum": ["claim", "equation", "method", "mechanism"]},
        "object_id": {"type": "string", "minLength": 1},
        "concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
        "matched_concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
        "record": {"type": "object", "minProperties": 1},
        "trust_class": {"const": "curated_repository_authority"}
      },
      "additionalProperties": false
    },
    "externalEvidence": {
      "type": "object",
      "required": ["origin", "source_id", "locator", "content_hash", "passage", "retrieval_query", "retrieved_at", "score", "metadata", "trust_class"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "passage": {"type": "string", "minLength": 1},
        "retrieval_query": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": ["string", "null"]},
        "score": {"type": ["number", "null"]},
        "metadata": {"type": "object"},
        "trust_class": {"const": "untrusted_external_evidence"}
      },
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "required": ["kind", "details"],
      "properties": {
        "kind": {"enum": ["authored_conflict", "domain_rejection", "rule_violation"]},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "rejection": {
      "type": "object",
      "required": ["id", "name", "reason_code", "reasons", "via_edge", "policy_version", "details"],
      "properties": {
        "id": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"},
        "name": {"type": ["string", "null"]},
        "reason_code": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "via_edge": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1},
        "details": {"type": "object"}
      },
      "additionalProperties": false
    },
    "knowledgeGap": {
      "type": "object",
      "required": ["status", "should_retrieve", "coverage", "covered_terms", "uncovered_terms", "suggested_query", "reason", "policy_version"],
      "properties": {
        "status": {"enum": ["none", "partial", "missing"]},
        "should_retrieve": {"type": "boolean"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "covered_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "uncovered_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "suggested_query": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "policy_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "budgetReport": {
      "type": "object",
      "required": ["available_tokens", "used_tokens", "estimator", "scope", "omitted_items"],
      "properties": {
        "available_tokens": {"type": "integer", "minimum": 1},
        "used_tokens": {"type": "integer", "minimum": 1},
        "estimator": {"const": "canonical-json-utf8-bytes-ceil-div-4"},
        "scope": {"const": "complete_context_bundle"},
        "omitted_items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["section", "item_id", "estimated_tokens", "reason"],
            "properties": {
              "section": {"enum": ["selected_concepts", "typed_paths", "mappings", "knowledge_objects", "curated_evidence", "external_evidence", "conflicts", "rejections"]},
              "item_id": {"type": "string", "minLength": 1},
              "estimated_tokens": {"type": "integer", "minimum": 1},
              "reason": {"enum": ["token_budget_exceeded", "dependency_omitted", "duplicate_content_hash", "external_evidence_disabled", "no_declared_knowledge_gap"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "trustBoundary": {
      "type": "object",
      "required": ["curated", "immutable", "derived", "external"],
      "properties": {
        "curated": {"const": "repository_authority"},
        "immutable": {"const": "append_only_evidence"},
        "derived": {"const": "rebuildable_ranking_signal"},
        "external": {"const": "untrusted_external_evidence"}
      },
      "additionalProperties": false
    },
    "temporal": {
      "type": "object",
      "required": ["policy_version", "validity_mode", "as_of", "replacement_traces"],
      "properties": {
        "policy_version": {"const": "cpcs-temporal/1.0"},
        "validity_mode": {"enum": ["current", "historical", "all_versions"]},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "replacement_traces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["selected_id", "selected_validity", "predecessors", "successors", "current_head", "policy_version"],
            "properties": {
              "selected_id": {"type": "string"},
              "selected_validity": {"$ref": "#/$defs/validity"},
              "predecessors": {"type": "array", "items": {"type": "string"}},
              "successors": {"type": "array", "items": {"type": "string"}},
              "current_head": {"type": ["string", "null"]},
              "policy_version": {"const": "cpcs-temporal/1.0"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "validity": {
      "type": "object",
      "required": ["valid_from", "valid_until", "status", "supersedes", "superseded_by"],
      "properties": {
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["active", "superseded", "deprecated"]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "superseded_by": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "policyVersions": {
      "type": "object",
      "required": ["context", "query", "gap", "edge", "temporal"],
      "properties": {
        "context": {"const": "cpcs-context/1.1"},
        "query": {"type": "string", "minLength": 1},
        "gap": {"type": "string", "minLength": 1},
        "edge": {"type": "string", "minLength": 1},
        "temporal": {"const": "cpcs-temporal/1.0"}
      },
      "additionalProperties": false
    }
  }
}
