{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/mechanism/1.1",
  "type": "object",
  "required": [
    "id", "concept_ids", "name", "purpose", "intent_effect",
    "causal_hypothesis", "causal_chain", "claim_ids", "method_ids",
    "equation_ids", "controls", "prerequisites", "conflicts",
    "verification_metrics", "failure_conditions", "limitations",
    "epistemic_class", "evidence_status", "confidence", "confidence_basis",
    "status", "sources"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^mechanism_[A-Za-z0-9._-]+$"},
    "concept_ids": {"$ref": "#/$defs/conceptIds"},
    "name": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "intent_effect": {"type": "string", "minLength": 1},
    "causal_hypothesis": {"type": "string", "minLength": 1},
    "causal_chain": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "claim_ids": {"$ref": "#/$defs/claimIds"},
    "method_ids": {"$ref": "#/$defs/methodIds"},
    "equation_ids": {"$ref": "#/$defs/equationIds"},
    "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "prerequisites": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "verification_metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["metric_id", "observable", "success_condition"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "observable": {"type": "string", "minLength": 1},
          "success_condition": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "failure_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "epistemic_class": {"$ref": "#/$defs/epistemicClass"},
    "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_basis": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "sources": {"$ref": "#/$defs/sources"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "validity": {"$ref": "#/$defs/validity"}
  },
  "additionalProperties": false,
  "$defs": {
    "conceptIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
    "claimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^claim_[A-Za-z0-9._-]+$"}},
    "methodIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^method_[A-Za-z0-9._-]+$"}},
    "equationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^equation_[A-Za-z0-9._-]+$"}},
    "epistemicClass": {"enum": ["measured", "detected", "inferred", "interpreted", "authored", "simulated", "derived"]},
    "evidenceStatus": {"enum": ["unverified", "supported", "contradicted", "qualified", "deprecated"]},
    "status": {"enum": ["ingested", "partial", "proven", "deprecated"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "locator", "content_sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "provenance": {"type": "object", "required": ["origin", "proposal_id", "promoted_by", "promoted_at", "source_evidence", "distillation", "validation", "deduplication", "review"], "properties": {"origin": {"type": "string", "minLength": 1}, "proposal_id": {"type": "string", "pattern": "^proposal_[A-Za-z0-9._-]+$"}, "promoted_by": {"type": "string", "minLength": 1}, "promoted_at": {"type": "string", "format": "date-time"}, "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "distillation": {"type": "array", "items": {"type": "object"}}, "distillation_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^distill_[0-9a-f]{24}$"}}, "validation": {"type": "object"}, "deduplication": {"type": "object"}, "review": {"type": "object"}}, "additionalProperties": false},
    "validity": {"type": "object", "required": ["valid_from", "valid_until", "status", "supersedes", "superseded_by"], "properties": {"valid_from": {"type": ["string", "null"], "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "status": {"enum": ["active", "superseded", "deprecated"]}, "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mechanism_[A-Za-z0-9._-]+$"}}, "superseded_by": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^mechanism_[A-Za-z0-9._-]+$"}}}, "additionalProperties": false}
  }
}
