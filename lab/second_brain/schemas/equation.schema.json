{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/equation/1.1",
  "type": "object",
  "required": [
    "id", "concept_ids", "name", "expression", "notation", "solved_quantity",
    "terms", "variables", "assumptions", "constraints", "method_ids",
    "mechanism_ids", "operational_mappings", "operational_effect",
    "execution_scope", "epistemic_class", "evidence_status", "confidence",
    "confidence_basis", "status", "sources"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^equation_[A-Za-z0-9._-]+$"},
    "concept_ids": {"$ref": "#/$defs/conceptIds"},
    "name": {"type": "string", "minLength": 1},
    "expression": {"type": "string", "minLength": 1},
    "notation": {"enum": ["latex", "mathml", "plain_text", "code"]},
    "solved_quantity": {"type": "string", "minLength": 1},
    "terms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["symbol", "meaning"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "variables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["symbol", "meaning", "role"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "meaning": {"type": "string", "minLength": 1},
          "role": {"enum": ["input", "output", "constraint", "preference", "parameter", "metric"]},
          "unit": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "method_ids": {"$ref": "#/$defs/methodIds"},
    "mechanism_ids": {"$ref": "#/$defs/mechanismIds"},
    "operational_mappings": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["control_id", "effect", "method_id"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1},
          "effect": {"type": "string", "minLength": 1},
          "method_id": {"type": ["string", "null"], "pattern": "^method_[A-Za-z0-9._-]+$"}
        },
        "additionalProperties": false
      }
    },
    "operational_effect": {"type": "string", "minLength": 1},
    "execution_scope": {"enum": ["score_control", "compiler_constraint", "evaluation_only", "mixed"]},
    "epistemic_class": {"$ref": "#/$defs/epistemicClass"},
    "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_basis": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "sources": {"$ref": "#/$defs/sources"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "validity": {"$ref": "#/$defs/validity"}
  },
  "additionalProperties": false,
  "$defs": {
    "conceptIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
    "methodIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^method_[A-Za-z0-9._-]+$"}},
    "mechanismIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mechanism_[A-Za-z0-9._-]+$"}},
    "epistemicClass": {"enum": ["measured", "detected", "inferred", "interpreted", "authored", "simulated", "derived"]},
    "evidenceStatus": {"enum": ["unverified", "supported", "contradicted", "qualified", "deprecated"]},
    "status": {"enum": ["ingested", "partial", "proven", "deprecated"]},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["ref", "locator", "content_sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}, "additionalProperties": false}},
    "provenance": {"type": "object", "required": ["origin", "proposal_id", "promoted_by", "promoted_at", "source_evidence", "distillation", "validation", "deduplication", "review"], "properties": {"origin": {"type": "string", "minLength": 1}, "proposal_id": {"type": "string", "pattern": "^proposal_[A-Za-z0-9._-]+$"}, "promoted_by": {"type": "string", "minLength": 1}, "promoted_at": {"type": "string", "format": "date-time"}, "source_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}}, "distillation": {"type": "array", "items": {"type": "object"}}, "distillation_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^distill_[0-9a-f]{24}$"}}, "validation": {"type": "object"}, "deduplication": {"type": "object"}, "review": {"type": "object"}}, "additionalProperties": false},
    "validity": {"type": "object", "required": ["valid_from", "valid_until", "status", "supersedes", "superseded_by"], "properties": {"valid_from": {"type": ["string", "null"], "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}, "status": {"enum": ["active", "superseded", "deprecated"]}, "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^equation_[A-Za-z0-9._-]+$"}}, "superseded_by": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^equation_[A-Za-z0-9._-]+$"}}}, "additionalProperties": false}
  }
}
