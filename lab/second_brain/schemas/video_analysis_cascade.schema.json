{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/video-analysis-cascade/1.0",
  "type": "object",
  "required": ["schema", "cascade_id", "source", "authorized_interval", "source_map_profile", "segment_profile", "deep_analysis_profiles", "candidate_concepts", "created_at"],
  "properties": {
    "schema": {"const": "cpcs.video_analysis_cascade/1.0"},
    "cascade_id": {"type": "string", "pattern": "^tl_cascade_[A-Za-z0-9._-]+$"},
    "source": {
      "type": "object",
      "required": ["source_id", "asset_ref", "asset_job_id", "local_path", "sha256", "rights_scope"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "asset_ref": {"type": "string", "minLength": 1},
        "asset_job_id": {"type": "string", "pattern": "^tl_asset_[A-Za-z0-9._-]+$"},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rights_scope": {"enum": ["authorized", "original", "licensed"]}
      },
      "additionalProperties": false
    },
    "authorized_interval": {
      "type": "object",
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "source_map_profile": {"const": "pegasus.source_map/1.0"},
    "segment_profile": {"type": "string", "pattern": "^pegasus\\.[a-z0-9_]+/1\\.0$"},
    "deep_analysis_profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^pegasus\\.[a-z0-9_]+/1\\.0$"}},
    "candidate_concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_"}},
    "measurement_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^measurement_obs_"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
