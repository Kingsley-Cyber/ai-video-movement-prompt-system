{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/domain-coverage-report/1.0",
  "type": "object",
  "required": ["schema", "policy_version", "manifests", "summary", "report_hash"],
  "properties": {
    "schema": {"const": "cpcs.domain_coverage_report/1.0"},
    "policy_version": {"const": "cpcs-domain-coverage/1.0"},
    "manifests": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "required": ["manifests", "source_complete_manifests", "expected", "curated", "operationally_mapped", "retrieval_qualified", "missing"],
      "properties": {
        "manifests": {"type": "integer", "minimum": 0},
        "source_complete_manifests": {"type": "integer", "minimum": 0},
        "expected": {"type": "integer", "minimum": 0},
        "curated": {"type": "integer", "minimum": 0},
        "operationally_mapped": {"type": "integer", "minimum": 0},
        "retrieval_qualified": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "report_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
