{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/normalized-video-observation/1.0",
  "type": "object",
  "required": ["schema", "observation_id", "source_id", "source_sha256", "interval", "subject_refs", "layer", "claim", "evidence_class", "confidence", "alternatives", "provenance"],
  "properties": {
    "schema": {"const": "cpcs.normalized_video_observation/1.0"},
    "observation_id": {"type": "string", "pattern": "^vog_obs_[A-Za-z0-9._-]+$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "interval": {
      "type": "object",
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "subject_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "layer": {"enum": ["entity", "beat", "action", "camera", "performance", "face_affect", "audio", "marketing", "segment", "measurement", "quality", "corpus"]},
    "claim": {"type": "object", "minProperties": 1},
    "evidence_class": {"enum": ["measured", "detected", "inferred", "interpreted"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "alternatives": {"type": "array", "items": {"type": "object", "minProperties": 1}},
    "provenance": {
      "type": "object",
      "required": ["surface", "model", "model_version", "profile_id", "request_hash", "raw_response_hash"],
      "properties": {
        "surface": {"enum": ["pegasus_analyze", "pegasus_segment", "pegasus_batch", "knowledge_store_search", "jockey", "marengo", "local_measurement"]},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "profile_id": {"type": "string", "minLength": 1},
        "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "raw_response_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
