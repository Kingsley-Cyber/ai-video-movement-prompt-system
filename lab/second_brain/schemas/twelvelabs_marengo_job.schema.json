{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/twelvelabs-marengo-job/1.0",
  "type": "object",
  "required": ["schema", "job_id", "input_type", "created_at"],
  "properties": {
    "schema": {"const": "cpcs.twelvelabs_marengo_job/1.0"},
    "job_id": {"type": "string", "pattern": "^tl_marengo_[A-Za-z0-9._-]+$"},
    "input_type": {"enum": ["video", "audio", "text", "image", "multi_input"]},
    "text": {"type": ["string", "null"], "minLength": 1},
    "asset_id": {"type": ["string", "null"], "minLength": 1},
    "image_asset_ids": {"type": "array", "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
