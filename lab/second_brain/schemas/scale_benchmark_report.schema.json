{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/scale-benchmark-report/1.0",
  "type": "object",
  "required": [
    "schema",
    "benchmark_id",
    "benchmark_hash",
    "source_authority_hash",
    "authority_unchanged",
    "environment",
    "scale_results",
    "summary",
    "status"
  ],
  "properties": {
    "schema": {"const": "cpcs.scale_benchmark_report/1.0"},
    "benchmark_id": {"type": "string"},
    "benchmark_hash": {"$ref": "#/$defs/hash"},
    "source_authority_hash": {"$ref": "#/$defs/hash"},
    "authority_unchanged": {"type": "boolean"},
    "environment": {
      "type": "object",
      "required": ["python", "implementation", "platform"],
      "properties": {
        "python": {"type": "string"},
        "implementation": {"type": "string"},
        "platform": {"type": "string"}
      },
      "additionalProperties": false
    },
    "scale_results": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scale_result"}
    },
    "summary": {
      "type": "object",
      "required": ["scales", "scales_passed", "largest_concept_count", "query_cases", "query_cases_passed"],
      "properties": {
        "scales": {"type": "integer", "minimum": 1},
        "scales_passed": {"type": "integer", "minimum": 0},
        "largest_concept_count": {"type": "integer", "minimum": 1},
        "query_cases": {"type": "integer", "minimum": 1},
        "query_cases_passed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["passed", "failed"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "measurement": {
      "type": "object",
      "required": ["seconds", "peak_python_bytes"],
      "properties": {
        "seconds": {"type": "number", "minimum": 0},
        "peak_python_bytes": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "query_result": {
      "type": "object",
      "required": [
        "case_id",
        "selected_concepts",
        "missing_expected",
        "selected_forbidden",
        "replay_hashes",
        "replay_seconds",
        "deterministic_replay",
        "status"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "selected_concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "missing_expected": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "selected_forbidden": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "replay_hashes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/hash"}},
        "replay_seconds": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": 0}},
        "deterministic_replay": {"type": "boolean"},
        "status": {"enum": ["passed", "failed"]}
      },
      "additionalProperties": false
    },
    "scale_result": {
      "type": "object",
      "required": [
        "factor",
        "fixture_hash",
        "fixture_counts",
        "measurements",
        "query_results",
        "query_p95_seconds",
        "query_total_seconds",
        "query_peak_python_bytes",
        "rebuild_deterministic",
        "rebuild_hash",
        "threshold_failures",
        "status"
      ],
      "properties": {
        "factor": {"type": "integer", "minimum": 2},
        "fixture_hash": {"$ref": "#/$defs/hash"},
        "fixture_counts": {
          "type": "object",
          "required": ["concepts", "edges", "mappings"],
          "properties": {
            "concepts": {"type": "integer", "minimum": 1},
            "edges": {"type": "integer", "minimum": 0},
            "mappings": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "measurements": {
          "type": "object",
          "required": ["ingest", "graph_build", "index_build", "rebuild_first", "rebuild_second"],
          "properties": {
            "ingest": {"$ref": "#/$defs/measurement"},
            "graph_build": {"$ref": "#/$defs/measurement"},
            "index_build": {"$ref": "#/$defs/measurement"},
            "rebuild_first": {"$ref": "#/$defs/measurement"},
            "rebuild_second": {"$ref": "#/$defs/measurement"}
          },
          "additionalProperties": false
        },
        "query_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/query_result"}},
        "query_p95_seconds": {"type": "number", "minimum": 0},
        "query_total_seconds": {"type": "number", "minimum": 0},
        "query_peak_python_bytes": {"type": "integer", "minimum": 0},
        "rebuild_deterministic": {"type": "boolean"},
        "rebuild_hash": {"$ref": "#/$defs/hash"},
        "threshold_failures": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "status": {"enum": ["passed", "failed"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
