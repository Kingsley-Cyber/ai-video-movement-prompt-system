{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/improvement-orchestration/1.0",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "required": ["candidate_id", "candidate_type", "status", "claim", "source_edge_ids", "evidence_ids", "provider", "model_version", "domain", "limitations"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^improvement_candidate_[0-9a-f]{24}$"},
        "candidate_type": {"enum": ["working_pattern", "failure_card", "provider_recommendation", "compiler_recipe", "profile_update", "research_gap"]},
        "status": {"const": "staged_unreviewed"},
        "claim": {"type": "string", "minLength": 1},
        "source_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "provider": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "domain": {"type": ["string", "null"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "id", "policy_version", "request_hash", "flight", "acceptance", "evidence_snapshot", "reflection", "query_traces", "candidates", "authority_effects", "prior_record_hash", "record_hash"],
  "properties": {
    "schema": {"const": "cpcs.improvement_orchestration/1.0"},
    "id": {"type": "string", "pattern": "^improvement_[0-9a-f]{24}$"},
    "policy_version": {"const": "cpcs-improvement-orchestrator/1.0"},
    "request_hash": {"$ref": "#/$defs/sha256"},
    "flight": {
      "type": "object",
      "required": ["flight_id", "flight_hash", "classification", "causal_eligibility", "arm_ids"],
      "properties": {
        "flight_id": {"type": "string", "pattern": "^flight_"},
        "flight_hash": {"$ref": "#/$defs/sha256"},
        "classification": {"const": "isolated_comparison"},
        "causal_eligibility": {"const": "eligible"},
        "arm_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "required": ["accepted_by", "accepted_at", "rationale"],
      "properties": {
        "accepted_by": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidence_snapshot": {
      "type": "object",
      "required": ["snapshot_hash", "run_ids", "run_fingerprints", "run_record_hashes", "testimonial_review_ids", "projected_causal_edge_ids"],
      "properties": {
        "snapshot_hash": {"$ref": "#/$defs/sha256"},
        "run_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^r_exp_"}},
        "run_fingerprints": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "run_record_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "testimonial_review_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^testimonial_review_"}},
        "projected_causal_edge_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^learned_"}}
      },
      "additionalProperties": false
    },
    "reflection": {
      "type": "object",
      "required": ["algorithm_version", "derivation_policy", "before_state_hash", "after_state_hash", "before_outputs", "after_outputs", "changed_files"],
      "properties": {
        "algorithm_version": {"type": "string"},
        "derivation_policy": {"type": "string"},
        "before_state_hash": {"$ref": "#/$defs/sha256"},
        "after_state_hash": {"$ref": "#/$defs/sha256"},
        "before_outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "after_outputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "changed_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "query_traces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["query_hash", "before_result_hash", "after_result_hash", "learned_edge_ids", "cited_run_ids", "cites_accepted_evidence"],
        "properties": {
          "query_hash": {"$ref": "#/$defs/sha256"},
          "before_result_hash": {"$ref": "#/$defs/sha256"},
          "after_result_hash": {"$ref": "#/$defs/sha256"},
          "learned_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "cited_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "cites_accepted_evidence": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "candidates": {
      "type": "object",
      "required": ["working_patterns", "failure_cards", "provider_recommendations", "compiler_recipes", "profile_updates", "research_gaps"],
      "properties": {
        "working_patterns": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "failure_cards": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "provider_recommendations": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "compiler_recipes": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "profile_updates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
        "research_gaps": {"type": "array", "items": {"$ref": "#/$defs/candidate"}}
      },
      "additionalProperties": false
    },
    "authority_effects": {
      "type": "object",
      "required": ["curated_before_hash", "curated_after_hash", "curated_unchanged", "immutable_run_ids", "derived_only", "promotion_performed"],
      "properties": {
        "curated_before_hash": {"$ref": "#/$defs/sha256"},
        "curated_after_hash": {"$ref": "#/$defs/sha256"},
        "curated_unchanged": {"const": true},
        "immutable_run_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "derived_only": {"const": true},
        "promotion_performed": {"const": false}
      },
      "additionalProperties": false
    },
    "prior_record_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_hash": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
