{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/reasoning-query/1.0",
  "type": "object",
  "required": ["goal", "domain", "target_format", "provider", "model_version", "required_layers", "excluded_layers", "maximum_depth", "minimum_status", "include_unproven", "deterministic_seed", "as_of", "validity_mode"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "domain": {"type": ["string", "null"]},
    "target_format": {"enum": ["prose", "natural_language", "yaml", "json", "xml", "hybrid"]},
    "provider": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "required_layers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "excluded_layers": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "maximum_depth": {"type": "integer", "minimum": 0, "maximum": 12},
    "minimum_status": {"enum": ["ingested", "partial", "proven"]},
    "include_unproven": {"type": "boolean"},
    "deterministic_seed": {"type": "integer"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "valid_at": {"type": ["string", "null"], "format": "date-time"},
    "known_at": {"type": ["string", "null"], "format": "date-time"},
    "validity_mode": {"enum": ["current", "historical", "all_versions"]},
    "retrieval_frame": {
      "anyOf": [
        {"type": "object"},
        {"type": "null"}
      ]
    },
    "terminology_proposal_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^termprop_[0-9a-f]{24}$"}
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "not": {"required": ["as_of", "valid_at"], "properties": {"as_of": {"type": "string"}, "valid_at": {"type": "string"}}}
    },
    {
      "if": {"properties": {"validity_mode": {"const": "historical"}}},
      "then": {"anyOf": [{"properties": {"as_of": {"type": "string", "format": "date-time"}}, "required": ["as_of"]}, {"properties": {"valid_at": {"type": "string", "format": "date-time"}}, "required": ["valid_at"]}]},
      "else": {"properties": {"as_of": {"type": "null"}, "valid_at": {"type": ["null"]}}}
    }
  ]
}
