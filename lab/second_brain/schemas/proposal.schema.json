{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/proposal/1.0",
  "type": "object",
  "required": ["proposal_id", "proposal_type", "status", "proposed_record", "source_evidence", "created_by", "created_at"],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^proposal_[A-Za-z0-9._-]+$"},
    "proposal_type": {"enum": ["concept", "edge", "intent", "mapping", "rule", "claim", "equation", "method", "mechanism", "reasoning_policy"]},
    "status": {"enum": ["pending", "rejected", "promoted"]},
    "proposed_record": {"type": "object", "minProperties": 1},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "locator", "claim"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "content_sha256": {"type": ["string", "null"], "pattern": "^(sha256:)?[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "dedup_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string"},
          "reason": {"type": "string"},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "created_by": {
      "enum": ["local_source", "manual", "polymath_mcp", "pegasus", "rag_pipeline"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "promotion": {"type": ["object", "null"]},
    "rejection_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
