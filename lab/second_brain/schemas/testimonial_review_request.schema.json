{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/testimonial-review-request/1.0",
  "type": "object",
  "required": [
    "schema", "testimonial_id", "normalization", "reviewed_by", "reviewed_at",
    "supersedes_reviews"
  ],
  "properties": {
    "schema": {"const": "cpcs.testimonial_review_request/1.0"},
    "testimonial_id": {"type": "string", "pattern": "^testimonial_[0-9a-f]{24}$"},
    "normalization": {"$ref": "#/$defs/normalization"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 200},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "supersedes_reviews": {
      "type": "array", "maxItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^testimonial_review_[0-9a-f]{24}$"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "dimension": {
      "enum": [
        "intent", "beat_order", "timing", "performance", "displayed_affect",
        "face", "gaze", "head", "blink", "breath", "motion", "contact",
        "interaction", "camera", "editing", "identity", "product", "continuity",
        "audio", "style", "negative_constraints", "provider_adherence"
      ]
    },
    "span": {
      "type": "object",
      "required": ["start", "end", "quote", "quote_hash"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1, "maxLength": 32768},
        "quote_hash": {"$ref": "#/$defs/hash"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["dimension", "text", "confidence", "evidence_spans"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "text": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_spans": {
          "type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/span"}
        }
      },
      "additionalProperties": false
    },
    "dimensionFinding": {
      "type": "object",
      "required": ["dimension", "verdict", "observation", "confidence", "evidence_spans"],
      "properties": {
        "dimension": {"$ref": "#/$defs/dimension"},
        "verdict": {"enum": ["pass", "fail", "mixed", "unobservable"]},
        "observation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_spans": {
          "type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/span"}
        }
      },
      "additionalProperties": false
    },
    "authoredTarget": {
      "oneOf": [
        {
          "type": "object",
          "required": ["target_type", "target_ref"],
          "properties": {
            "target_type": {"const": "concept"},
            "target_ref": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["target_type", "target_ref"],
          "properties": {
            "target_type": {"const": "canonical_control"},
            "target_ref": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "metricFinding": {
      "type": "object",
      "required": [
        "metric_id", "value", "verdict", "observation", "confidence",
        "authored_targets", "evidence_spans", "limitations"
      ],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"},
        "value": {"type": ["number", "string", "boolean", "null"]},
        "verdict": {"enum": ["pass", "fail", "mixed", "unobservable"]},
        "observation": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "authored_targets": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/authoredTarget"}
        },
        "evidence_spans": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"$ref": "#/$defs/span"}
        },
        "limitations": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      },
      "additionalProperties": false
    },
    "attribution": {
      "type": "object",
      "required": [
        "target_type", "target_ref", "hypothesis", "confidence", "evidence_spans",
        "causal_status"
      ],
      "properties": {
        "target_type": {"enum": ["canonical_control", "prompt_span", "concept", "provider_behavior", "asset", "unknown"]},
        "target_ref": {"type": ["string", "null"], "maxLength": 1000},
        "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence_spans": {
          "type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/span"}
        },
        "causal_status": {"const": "unverified_candidate"}
      },
      "additionalProperties": false
    },
    "normalizer": {
      "type": "object",
      "required": ["origin", "agent", "model", "prompt_hash", "response_hash"],
      "properties": {
        "origin": {"enum": ["llm_proposal", "human_authored"]},
        "agent": {"type": ["string", "null"], "maxLength": 200},
        "model": {"type": ["string", "null"], "maxLength": 200},
        "prompt_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "response_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "llm_proposal"}}},
          "then": {
            "properties": {
              "agent": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "prompt_hash": {"$ref": "#/$defs/hash"},
              "response_hash": {"$ref": "#/$defs/hash"}
            }
          },
          "else": {
            "properties": {
              "agent": {"type": "null"}, "model": {"type": "null"},
              "prompt_hash": {"type": "null"}, "response_hash": {"type": "null"}
            }
          }
        }
      ]
    },
    "normalization": {
      "type": "object",
      "required": [
        "normalizer", "normalized_verdict", "summary", "confidence",
        "dimension_findings", "strengths", "failures", "attribution_candidates", "limitations"
      ],
      "properties": {
        "normalizer": {"$ref": "#/$defs/normalizer"},
        "normalized_verdict": {"enum": ["keep", "reject", "mixed", "unclear"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "dimension_findings": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/dimensionFinding"}
        },
        "metric_findings": {
          "type": "array", "maxItems": 64,
          "items": {"$ref": "#/$defs/metricFinding"}
        },
        "strengths": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}},
        "failures": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/finding"}},
        "attribution_candidates": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/attribution"}},
        "limitations": {
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      },
      "additionalProperties": false
    }
  }
}
