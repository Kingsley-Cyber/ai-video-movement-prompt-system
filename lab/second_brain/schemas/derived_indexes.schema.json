{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/derived-indexes/1.0",
  "type": "object",
  "required": [
    "schema",
    "algorithm_version",
    "input_hash",
    "lexical_concepts",
    "aliases",
    "dense_semantic_concepts",
    "typed_adjacency",
    "prerequisite_closure",
    "dependency_cycles",
    "conflicts",
    "temporal_validity",
    "supersession",
    "concept_to_source",
    "concept_to_evidence",
    "concept_to_knowledge_object",
    "knowledge_object_lexical",
    "knowledge_object_links",
    "reasoning_policy_lexical",
    "reasoning_policy_to_concept",
    "task_class_to_reasoning_policy",
    "intent_to_concept",
    "control_to_provider",
    "provider_performance",
    "experiments",
    "video_observations",
    "edge_distribution"
  ],
  "properties": {
    "schema": {"const": "cpcs.derived_indexes/1.0"},
    "algorithm_version": {"const": "cpcs-derived-indexes/1.4"},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "lexical_concepts": {"$ref": "#/$defs/stringArrayMap"},
    "aliases": {"$ref": "#/$defs/stringArrayMap"},
    "dense_semantic_concepts": {
      "type": "object",
      "required": ["algorithm", "dimensions", "corpus_size", "token_idf", "vectors"],
      "properties": {
        "algorithm": {"const": "signed-hashed-tfidf/1.0"},
        "dimensions": {"type": "integer", "minimum": 1},
        "corpus_size": {"type": "integer", "minimum": 0},
        "token_idf": {"type": "object", "additionalProperties": {"type": "number"}},
        "vectors": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "number"}}
        }
      },
      "additionalProperties": false
    },
    "typed_adjacency": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/adjacencyItem"}}},
    "prerequisite_closure": {"$ref": "#/$defs/stringArrayMap"},
    "dependency_cycles": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "conflicts": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/adjacencyItem"}}},
    "temporal_validity": {
      "type": "object",
      "required": ["policy_version", "bitemporal_policy_version", "view_mode", "as_of", "valid_at", "known_at", "visible_records", "records", "current_heads"],
      "properties": {
        "policy_version": {"const": "cpcs-temporal/1.0"},
        "bitemporal_policy_version": {"const": "cpcs-bitemporal/1.0"},
        "view_mode": {"enum": ["current", "historical", "all_versions"]},
        "as_of": {"type": ["string", "null"], "format": "date-time"},
        "valid_at": {"type": ["string", "null"], "format": "date-time"},
        "known_at": {"type": ["string", "null"], "format": "date-time"},
        "visible_records": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "records": {"type": "object", "additionalProperties": {"$ref": "#/$defs/temporalRecord"}},
        "current_heads": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "supersession": {"type": "object", "additionalProperties": {"$ref": "#/$defs/supersessionRecord"}},
    "concept_to_source": {"$ref": "#/$defs/stringArrayMap"},
    "concept_to_evidence": {"$ref": "#/$defs/stringArrayMap"},
    "concept_to_knowledge_object": {"$ref": "#/$defs/stringArrayMap"},
    "knowledge_object_lexical": {"$ref": "#/$defs/stringArrayMap"},
    "knowledge_object_links": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/knowledgeObjectLink"}
      }
    },
    "reasoning_policy_lexical": {"$ref": "#/$defs/stringArrayMap"},
    "reasoning_policy_to_concept": {"$ref": "#/$defs/stringArrayMap"},
    "task_class_to_reasoning_policy": {"$ref": "#/$defs/stringArrayMap"},
    "intent_to_concept": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/intentMatch"}}},
    "control_to_provider": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/controlProvider"}}},
    "provider_performance": {"type": "object", "additionalProperties": {"$ref": "#/$defs/providerPerformance"}},
    "experiments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/experimentRecord"}},
    "video_observations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/videoObservation"}},
    "edge_distribution": {
      "type": "object",
      "required": ["policy_version", "total", "by_type", "pairs_with", "pairs_with_ratio", "reciprocal_pairs_with"],
      "properties": {
        "policy_version": {"const": "cpcs-typed-edge-distribution/1.3"},
        "total": {"type": "integer", "minimum": 0},
        "by_type": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "pairs_with": {"type": "integer", "minimum": 0, "maximum": 148},
        "pairs_with_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "reciprocal_pairs_with": {"const": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringArrayMap": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string"}
      }
    },
    "adjacencyItem": {
      "type": "object",
      "required": ["edge_id", "neighbor", "type", "family", "direction", "context"],
      "properties": {
        "edge_id": {"type": "string"},
        "neighbor": {"type": "string"},
        "type": {"type": "string"},
        "family": {"type": "string"},
        "direction": {"enum": ["forward", "reverse"]},
        "context": {"type": "string"}
      },
      "additionalProperties": false
    },
    "knowledgeObjectLink": {
      "type": "object",
      "required": ["target_id", "type"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "temporalRecord": {
      "type": "object",
      "required": ["store", "valid_from", "valid_until", "status", "supersedes", "superseded_by", "known_from", "known_until", "basis"],
      "properties": {
        "store": {"enum": ["concept", "edge", "mapping", "intent", "rule", "claim", "equation", "method", "mechanism", "reasoning_policy"]},
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["active", "superseded", "deprecated"]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "superseded_by": {"type": "array", "uniqueItems": true, "maxItems": 1, "items": {"type": "string"}},
        "known_from": {"type": ["string", "null"], "format": "date-time"},
        "known_until": {"type": ["string", "null"], "format": "date-time"},
        "basis": {"enum": ["legacy_open", "system_known_from", "promoted_at", "effective_at"]}
      },
      "additionalProperties": false
    },
    "supersessionRecord": {
      "type": "object",
      "required": ["supersedes", "superseded_by"],
      "properties": {
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "superseded_by": {"type": "array", "uniqueItems": true, "maxItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "intentMatch": {
      "type": "object",
      "required": ["concept_id", "matched_terms"],
      "properties": {
        "concept_id": {"type": "string"},
        "matched_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "controlProvider": {
      "type": "object",
      "required": ["mapping_id", "concept_id", "provider", "model_version", "encoding", "loss"],
      "properties": {
        "mapping_id": {"type": "string"},
        "concept_id": {"type": "string"},
        "provider": {"type": "string"},
        "model_version": {"type": "string"},
        "encoding": {"type": "string"},
        "loss": {"type": "string"}
      },
      "additionalProperties": false
    },
    "providerPerformance": {
      "type": "object",
      "required": ["policy_version", "run_ids", "verdict_counts", "compliance_status_counts", "design_counts", "controlled_run_ids", "bundled_run_ids", "causal_run_ids", "causal_edge_ids", "artifact_hashes", "causal_effects", "calibration_status", "evidence_class"],
      "properties": {
        "policy_version": {"const": "cpcs-provider-calibration/1.0"},
        "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "verdict_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "compliance_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "design_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "controlled_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "bundled_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "causal_run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "causal_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^learned_"}},
        "artifact_hashes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
        "causal_effects": {"type": "array", "items": {"$ref": "#/$defs/causalEffect"}},
        "calibration_status": {"enum": ["causal_signal_available", "noncausal_only", "legacy_only"]},
        "evidence_class": {"enum": ["immutable_run_history", "controlled_render_evidence"]}
      },
      "additionalProperties": false
    },
    "experimentRecord": {
      "type": "object",
      "required": ["flight_hash", "design_classification", "concept_ids", "arms", "run_ids", "compliance_report_ids", "causal_edge_ids"],
      "properties": {
        "flight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "design_classification": {"enum": ["isolated_comparison", "bundled_observation", "legacy_unrecorded"]},
        "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "arms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "compliance_report_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^compliance_"}},
        "causal_edge_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^learned_"}}
      },
      "additionalProperties": false
    },
    "causalEffect": {
      "type": "object",
      "required": ["flight_id", "flight_hash", "control_id", "concept_id", "winner", "loser", "same_seed", "same_compiler_version", "same_controls_except_delta", "same_intent_context_profiles_blocks_assets"],
      "properties": {
        "flight_id": {"type": "string", "pattern": "^flight_"},
        "flight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
        "concept_id": {"type": "string", "pattern": "^c_"},
        "winner": {"$ref": "#/$defs/causalArm"},
        "loser": {"$ref": "#/$defs/causalArm"},
        "same_seed": {"const": true},
        "same_compiler_version": {"const": true},
        "same_controls_except_delta": {"const": true},
        "same_intent_context_profiles_blocks_assets": {"const": true}
      },
      "additionalProperties": false
    },
    "causalArm": {
      "type": "object",
      "required": ["run_id", "build_id", "build_hash", "artifact_sha256", "compliance_report_id", "compliance_report_hash", "compliance_status", "human_review_id", "human_review_hash", "human_verdict", "control_value"],
      "properties": {
        "run_id": {"type": "string"},
        "build_id": {"type": ["string", "null"]},
        "build_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "compliance_report_id": {"type": ["string", "null"]},
        "compliance_report_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "compliance_status": {"type": ["string", "null"]},
        "human_review_id": {"type": ["string", "null"]},
        "human_review_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "human_verdict": {"type": ["string", "null"]},
        "control_value": {}
      },
      "additionalProperties": false
    },
    "videoObservation": {
      "type": "object",
      "required": ["pegasus", "measurement"],
      "properties": {
        "pegasus": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "measurement": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  }
}
