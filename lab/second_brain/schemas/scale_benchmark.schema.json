{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/scale-benchmark/1.0",
  "type": "object",
  "required": ["schema", "benchmark_id", "fixture_policy", "limits", "query_cases"],
  "properties": {
    "schema": {"const": "cpcs.scale_benchmark/1.0"},
    "benchmark_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "fixture_policy": {
      "type": "object",
      "required": ["scale_factors", "clone_relationship", "deterministic_replays", "minimum_status"],
      "properties": {
        "scale_factors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 2, "maximum": 100}
        },
        "clone_relationship": {"const": "refines"},
        "deterministic_replays": {"type": "integer", "minimum": 2, "maximum": 3},
        "minimum_status": {"enum": ["ingested", "partial", "proven"]}
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/limits"}
    },
    "query_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/query_case"}
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "required": [
        "ingest_seconds",
        "graph_build_seconds",
        "index_build_seconds",
        "query_p95_seconds",
        "query_total_seconds",
        "rebuild_max_seconds",
        "peak_python_bytes"
      ],
      "properties": {
        "ingest_seconds": {"type": "number", "exclusiveMinimum": 0},
        "graph_build_seconds": {"type": "number", "exclusiveMinimum": 0},
        "index_build_seconds": {"type": "number", "exclusiveMinimum": 0},
        "query_p95_seconds": {"type": "number", "exclusiveMinimum": 0},
        "query_total_seconds": {"type": "number", "exclusiveMinimum": 0},
        "rebuild_max_seconds": {"type": "number", "exclusiveMinimum": 0},
        "peak_python_bytes": {"type": "integer", "minimum": 1048576}
      },
      "additionalProperties": false
    },
    "query_case": {
      "type": "object",
      "required": ["case_id", "query", "domain", "expected_concepts", "forbidden_concepts"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "query": {"type": "string", "minLength": 1, "maxLength": 2000},
        "domain": {"type": ["string", "null"]},
        "expected_concepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}
        },
        "forbidden_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
