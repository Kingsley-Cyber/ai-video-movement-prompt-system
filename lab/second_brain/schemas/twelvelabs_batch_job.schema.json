{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/twelvelabs-batch-job/1.0",
  "type": "object",
  "required": ["schema", "job_id", "analysis_mode", "profile_id", "items", "created_at"],
  "properties": {
    "schema": {"const": "cpcs.twelvelabs_batch_job/1.0"},
    "job_id": {"type": "string", "pattern": "^tl_batch_[A-Za-z0-9._-]+$"},
    "analysis_mode": {"enum": ["general", "time_based_metadata"]},
    "profile_id": {"type": "string", "pattern": "^pegasus\\.[a-z0-9_]+/1\\.0$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["custom_id", "asset_ref", "sha256", "rights_scope", "interval"],
        "properties": {
          "custom_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
          "asset_ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "rights_scope": {"enum": ["authorized", "original", "licensed"]},
          "interval": {
            "type": "object",
            "required": ["source_start_s", "source_end_s"],
            "properties": {
              "source_start_s": {"type": "number", "minimum": 0},
              "source_end_s": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
