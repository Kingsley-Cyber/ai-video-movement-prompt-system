{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/run/1.0",
  "type": "object",
  "required": ["id", "flight_id", "flight_hash", "intent_id", "intent_class", "arm", "paradigm", "concept_ids", "concept_content_hashes", "provider", "model_version", "seed", "compiled_prompt_hash", "compiler_version", "repository_commit", "output_artifact_hash", "metrics", "verdict", "recorded_at", "prior_record_hash", "record_hash"],
  "properties": {
    "id": {"type": "string", "pattern": "^r[A-Za-z0-9._-]+$"},
    "flight_id": {"type": "string", "pattern": "^flight_"},
    "flight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "intent_id": {"type": ["string", "null"]},
    "intent_class": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "minLength": 1},
    "paradigm": {"type": "string", "minLength": 1},
    "concept_ids": {"type": "array", "items": {"type": "string", "pattern": "^c_"}},
    "concept_content_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "provider": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "null"]},
    "compiled_prompt_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "compiler_version": {"type": "string", "minLength": 1},
    "repository_commit": {"type": "string", "minLength": 1},
    "output_artifact_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "metrics": {"type": "object"},
    "controls": {"type": "object"},
    "tested_delta": {
      "type": ["object", "null"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^c_"},
        "control_id": {"type": "string"},
        "value": {}
      },
      "required": ["concept_id", "control_id"],
      "additionalProperties": false
    },
    "verdict": {"type": "string", "minLength": 1},
    "recorded_at": {"type": "string", "format": "date-time"},
    "prior_record_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "legacy": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
