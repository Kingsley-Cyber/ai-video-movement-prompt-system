{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/concept/1.0",
  "type": "object",
  "required": ["id", "kind", "name", "what", "use_when", "nl_triggers", "status", "evidence", "source", "layer"],
  "properties": {
    "id": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"},
    "kind": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "layer": {"type": "string", "minLength": 1},
    "what": {"type": "string", "minLength": 1},
    "use_when": {"type": "string", "minLength": 1},
    "nl_triggers": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "encodable_as": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "params": {"type": "object"},
    "status": {"enum": ["unexplored", "ingested", "partial", "proven", "deprecated"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {"type": "string"},
        "proposal_id": {"type": ["string", "null"]},
        "promoted_by": {"type": ["string", "null"]},
        "promoted_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
