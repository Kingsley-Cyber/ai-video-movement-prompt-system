{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/concept/1.0",
  "type": "object",
  "required": ["id", "kind", "name", "what", "use_when", "nl_triggers", "status", "evidence", "source", "layer"],
  "properties": {
    "id": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"},
    "kind": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "layer": {"type": "string", "minLength": 1},
    "what": {"type": "string", "minLength": 1},
    "use_when": {"type": "string", "minLength": 1},
    "nl_triggers": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "query_term_gate": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "any": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}},
        "all": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}}
      },
      "additionalProperties": false
    },
    "encodable_as": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "params": {
      "type": "object",
      "properties": {
        "fixed_set_member": {
          "type": "object",
          "required": [
            "set_id",
            "version",
            "code",
            "term",
            "definition",
            "visible_wording",
            "conflicts",
            "authority",
            "frame_of_reference",
            "model_support",
            "evidence_status",
            "definition_source",
            "visible_wording_status",
            "source_batch_sha256"
          ],
          "properties": {
            "set_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "term": {
              "type": "string",
              "minLength": 1
            },
            "definition": {
              "type": "string",
              "minLength": 1
            },
            "visible_wording": {
              "type": "string",
              "minLength": 1
            },
            "conflicts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "authority": {
              "enum": [
                "external_standard",
                "project_convention"
              ]
            },
            "frame_of_reference": {
              "enum": [
                "body",
                "world",
                "action_phase"
              ]
            },
            "model_support": {
              "const": "untested"
            },
            "evidence_status": {
              "enum": [
                "unexplored",
                "partial",
                "proven"
              ]
            },
            "definition_source": {
              "enum": [
                "exact_passage",
                "research_summary"
              ]
            },
            "visible_wording_status": {
              "enum": [
                "source_supplied",
                "proposed"
              ]
            },
            "source_batch_sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "recipe": {
              "type": "object",
              "required": [
                "weight",
                "time",
                "space"
              ],
              "properties": {
                "weight": {
                  "type": "string",
                  "minLength": 1
                },
                "time": {
                  "type": "string",
                  "minLength": 1
                },
                "space": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "status": {"enum": ["unexplored", "ingested", "partial", "proven", "deprecated"]},
    "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validity": {
      "type": "object",
      "required": ["valid_from", "valid_until", "status", "supersedes", "superseded_by"],
      "properties": {
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["active", "superseded", "deprecated"]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
        "superseded_by": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {"type": "string"},
        "proposal_id": {"type": ["string", "null"]},
        "promoted_by": {"type": ["string", "null"]},
        "promoted_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
