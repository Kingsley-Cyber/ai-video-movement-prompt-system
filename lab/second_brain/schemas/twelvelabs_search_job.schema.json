{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/twelvelabs-search-job/1.0",
  "type": "object",
  "required": ["schema", "job_id", "knowledge_store_id", "query", "modalities", "authorized_item_ids", "created_at"],
  "properties": {
    "schema": {"const": "cpcs.twelvelabs_search_job/1.0"},
    "job_id": {"type": "string", "pattern": "^tl_search_[A-Za-z0-9._-]+$"},
    "knowledge_store_id": {"type": "string", "pattern": "^ks_[A-Za-z0-9._-]+$"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["visual", "audio"]}},
    "authorized_item_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ksi_[A-Za-z0-9._-]+$"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
