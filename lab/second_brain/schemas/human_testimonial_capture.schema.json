{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/human-testimonial-capture/1.0",
  "type": "object",
  "required": [
    "schema", "render_result", "artifact_id", "speaker", "language",
    "raw_statement", "captured_at", "supersedes"
  ],
  "properties": {
    "schema": {"const": "cpcs.human_testimonial_capture/1.0"},
    "render_result": {"type": "string", "minLength": 1, "maxLength": 4096},
    "artifact_id": {"type": "string", "pattern": "^artifact_[0-9]{3}$"},
    "speaker": {"$ref": "#/$defs/speaker"},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "raw_statement": {"type": "string", "minLength": 1, "maxLength": 32768},
    "captured_at": {"type": "string", "format": "date-time"},
    "supersedes": {
      "type": "array", "maxItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^testimonial_[0-9a-f]{24}$"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "speaker": {
      "type": "object",
      "required": ["speaker_id", "role", "rights_basis"],
      "properties": {
        "speaker_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "role": {"enum": ["owner", "client", "reviewer", "audience_member", "collaborator", "other"]},
        "rights_basis": {"enum": ["owner_authored", "explicit_consent", "project_authorized"]}
      },
      "additionalProperties": false
    }
  }
}
