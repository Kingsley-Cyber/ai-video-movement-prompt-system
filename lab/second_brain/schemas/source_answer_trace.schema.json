{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/source-answer-trace/1.0",
  "type": "object",
  "required": [
    "schema", "question", "disposition", "unresolved_graph_slot", "matches",
    "source_unit_id", "source_id", "locator", "content_hash", "answer_span",
    "evidence_class", "uncertainty"
  ],
  "properties": {
    "schema": {"const": "cpcs.source_answer_trace/1.0"},
    "question": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["not_required", "answered_local", "not_found", "ambiguous"]},
    "unresolved_graph_slot": {
      "type": "object",
      "required": ["covered_terms", "uncovered_terms", "suggested_query"],
      "properties": {
        "covered_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "uncovered_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "suggested_query": {"type": "string"}
      },
      "additionalProperties": false
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_unit_id", "source_id", "locator", "content_hash"],
        "properties": {
          "source_unit_id": {"type": "string", "pattern": "^source_unit_[0-9a-f]{24}$"},
          "source_id": {"type": "string", "pattern": "^src_sha256_[0-9a-f]{64}$"},
          "locator": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "source_unit_id": {"type": ["string", "null"], "pattern": "^source_unit_[0-9a-f]{24}$"},
    "source_id": {"type": ["string", "null"], "pattern": "^src_sha256_[0-9a-f]{64}$"},
    "locator": {"type": ["string", "null"]},
    "content_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "answer_span": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["start_byte", "end_byte", "quote", "quote_hash"],
          "properties": {
            "start_byte": {"type": "integer", "minimum": 0},
            "end_byte": {"type": "integer", "minimum": 1},
            "quote": {"type": "string", "minLength": 1},
            "quote_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence_class": {
      "type": ["string", "null"],
      "enum": [null, "authored", "measured", "detected", "inferred", "interpreted", "simulated", "derived"]
    },
    "uncertainty": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
