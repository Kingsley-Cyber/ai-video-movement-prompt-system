{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/learned-weight/1.0",
  "type": "object",
  "required": ["id", "u", "v", "type", "weight", "evidence", "provider", "model_version", "context", "n_obs", "derivation_policy", "evidence_scope", "evidence_trace"],
  "properties": {
    "id": {"type": "string", "pattern": "^learned_[A-Za-z0-9._-]+$"},
    "u": {"type": "string", "minLength": 1},
    "v": {"type": "string", "minLength": 1},
    "type": {"enum": ["promotes", "associated_with_success", "co_success", "associated_with_failure", "confounded_with", "contradicts"]},
    "weight": {"type": "number", "minimum": -1, "maximum": 1},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provider": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "context": {"type": "string", "minLength": 1},
    "n_obs": {"type": "integer", "minimum": 1},
    "derivation_policy": {"type": "string", "minLength": 1},
    "evidence_scope": {"enum": ["causal_isolated_comparison", "noncausal_association", "noncausal_observation"]},
    "evidence_trace": {"type": "array", "items": {"$ref": "#/$defs/evidenceTrace"}},
    "isolated_comparison": {"$ref": "#/$defs/isolatedComparison"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "promotes"}}},
      "then": {
        "required": ["isolated_comparison"],
        "properties": {"evidence_scope": {"const": "causal_isolated_comparison"}}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidenceTrace": {
      "type": "object",
      "required": ["run_id", "build_id", "build_hash", "artifact_sha256", "compliance_report_id", "compliance_report_hash", "compliance_status", "human_review_id", "human_review_hash", "human_verdict"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "build_id": {"type": ["string", "null"]},
        "build_hash": {"$ref": "#/$defs/sha"},
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "compliance_report_id": {"type": ["string", "null"]},
        "compliance_report_hash": {"$ref": "#/$defs/sha"},
        "compliance_status": {"type": ["string", "null"]},
        "human_review_id": {"type": ["string", "null"]},
        "human_review_hash": {"$ref": "#/$defs/sha"},
        "human_verdict": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "isolatedComparison": {
      "type": "object",
      "required": ["flight_id", "flight_hash", "control_id", "concept_id", "winner", "loser", "same_seed", "same_compiler_version", "same_controls_except_delta", "same_intent_context_profiles_blocks_assets"],
      "properties": {
        "flight_id": {"type": "string", "pattern": "^flight_"},
        "flight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
        "concept_id": {"type": "string", "pattern": "^c_"},
        "winner": {"$ref": "#/$defs/armTrace"},
        "loser": {"$ref": "#/$defs/armTrace"},
        "same_seed": {"const": true},
        "same_compiler_version": {"const": true},
        "same_controls_except_delta": {"const": true},
        "same_intent_context_profiles_blocks_assets": {"const": true}
      },
      "additionalProperties": false
    },
    "armTrace": {
      "type": "object",
      "required": ["run_id", "build_id", "build_hash", "artifact_sha256", "compliance_report_id", "compliance_report_hash", "compliance_status", "human_review_id", "human_review_hash", "human_verdict", "control_value"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "build_id": {"type": ["string", "null"]},
        "build_hash": {"$ref": "#/$defs/sha"},
        "artifact_sha256": {"$ref": "#/$defs/sha"},
        "compliance_report_id": {"type": ["string", "null"]},
        "compliance_report_hash": {"$ref": "#/$defs/sha"},
        "compliance_status": {"type": ["string", "null"]},
        "human_review_id": {"type": ["string", "null"]},
        "human_review_hash": {"$ref": "#/$defs/sha"},
        "human_verdict": {"type": ["string", "null"]},
        "control_value": {}
      },
      "additionalProperties": false
    }
  }
}
