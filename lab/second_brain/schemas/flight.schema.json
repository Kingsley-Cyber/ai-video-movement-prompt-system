{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/flight/1.0",
  "type": "object",
  "required": ["id", "status", "intent_id", "intent_class", "arms", "concept_ids", "concept_content_hashes", "provider", "model_version", "seed", "compiler_settings", "sealed_at", "flight_hash"],
  "properties": {
    "id": {"type": "string", "pattern": "^flight_[A-Za-z0-9._-]+$"},
    "status": {"const": "sealed"},
    "intent_id": {"type": ["string", "null"]},
    "intent_class": {"type": "string", "minLength": 1},
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "paradigm"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "paradigm": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_"}},
    "concept_content_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "provider": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "seed": {"type": ["integer", "null"]},
    "compiler_settings": {"type": "object"},
    "sealed_at": {"type": "string", "format": "date-time"},
    "flight_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "legacy": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
