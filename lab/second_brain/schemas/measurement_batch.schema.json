{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/measurement-batch/1.0",
  "type": "object",
  "required": ["schema", "batch_id", "job_id", "source", "authorized_interval", "tool", "model_version", "parameters", "observations", "summary", "created_at"],
  "properties": {
    "schema": {"const": "cpcs.measurement_batch/1.0"},
    "batch_id": {"type": "string", "pattern": "^measurement_batch_[0-9a-f]{24}$"},
    "job_id": {"type": "string", "pattern": "^pose_job_[0-9a-f]{24}$"},
    "source": {
      "type": "object",
      "required": ["source_id", "asset_ref", "sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "asset_ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "authorized_interval": {
      "type": "object",
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "tool": {"const": "mediapipe_pose"},
    "model_version": {"type": "string", "minLength": 1},
    "parameters": {"type": "object", "minProperties": 1},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "measurement_job_id", "source_asset_ref", "source_sha256", "tool", "model_version", "model_sha256", "parameters_hash", "interval", "claim", "concept_ids", "candidate_concepts", "evidence_class", "confidence", "created_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^measurement_obs_[0-9a-f]{24}$"},
          "measurement_job_id": {"type": "string", "pattern": "^pose_job_[0-9a-f]{24}$"},
          "source_asset_ref": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "tool": {"const": "mediapipe_pose"},
          "model_version": {"type": "string", "minLength": 1},
          "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parameters_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "interval": {
            "type": "object",
            "required": ["start_s", "end_s"],
            "properties": {
              "start_s": {"type": "number", "minimum": 0},
              "end_s": {"type": "number", "exclusiveMinimum": 0}
            },
            "additionalProperties": false
          },
          "claim": {"type": "object", "minProperties": 1},
          "concept_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_"}},
          "candidate_concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^c_"}},
          "evidence_class": {"const": "detected"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "created_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["frames_processed", "frames_with_pose", "actors", "possible_swap_frames", "observation_count"],
      "properties": {
        "frames_processed": {"type": "integer", "minimum": 0},
        "frames_with_pose": {"type": "integer", "minimum": 0},
        "actors": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^actor_[A-Z]+$"}},
        "possible_swap_frames": {"type": "integer", "minimum": 0},
        "observation_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
