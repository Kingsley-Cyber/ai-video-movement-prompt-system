{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/knowledge-comparison-lens/1.0",
  "type": "object",
  "required": ["schema", "policy_version", "query", "retrieval_frame", "concepts", "comparison_dimensions", "reference", "candidate", "lens_hash"],
  "properties": {
    "schema": {"const": "cpcs.knowledge_comparison_lens/1.0"},
    "policy_version": {"const": "cpcs-knowledge-comparison-lens/1.0"},
    "query": {"type": "string", "minLength": 1},
    "retrieval_frame": {"type": "object"},
    "concepts": {"type": "array", "items": {"type": "object"}},
    "comparison_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "reference": {"type": "object"},
    "candidate": {"type": "object"},
    "lens_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
