{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/experiment-flight-preparation/1.0",
  "$defs": {
    "delta": {
      "type": ["object", "null"],
      "properties": {
        "concept_id": {"type": "string", "pattern": "^c_"},
        "control_id": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"},
        "value": {}
      },
      "required": ["concept_id", "control_id", "value"],
      "additionalProperties": false
    },
    "arm": {
      "type": "object",
      "required": ["id", "paradigm", "tested_delta"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "paradigm": {"const": "universal_score"},
        "tested_delta": {"$ref": "#/$defs/delta"}
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "required": ["classification", "causal_claim_policy", "metric_ids", "outcome_concept_ids"],
      "properties": {
        "classification": {"enum": ["isolated_comparison", "bundled_observation"]},
        "causal_claim_policy": {"const": "isolated_only"},
        "metric_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "outcome_concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c_"}
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema", "flight_draft", "builds", "differing_control_ids"],
  "properties": {
    "schema": {"const": "cpcs.experiment_flight_preparation/1.0"},
    "flight_draft": {
      "type": "object",
      "required": ["id", "intent_id", "intent_class", "arms", "design", "concept_ids", "provider", "model_version", "seed", "compiler_settings", "sealed_at", "legacy"],
      "properties": {
        "id": {"type": "string", "pattern": "^flight_[A-Za-z0-9._-]+$"},
        "intent_id": {"type": ["string", "null"]},
        "intent_class": {"type": "string", "minLength": 1},
        "arms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/arm"}
        },
        "design": {"$ref": "#/$defs/design"},
        "concept_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^c_"}
        },
        "provider": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "seed": {"type": "integer"},
        "compiler_settings": {
          "type": "object",
          "required": ["version"],
          "properties": {"version": {"type": "string", "minLength": 1}},
          "additionalProperties": false
        },
        "sealed_at": {"type": "string", "format": "date-time"},
        "legacy": {"type": "null"}
      },
      "additionalProperties": false
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["arm_id", "build_id", "build_hash", "score_id", "score_hash"],
        "properties": {
          "arm_id": {"type": "string", "minLength": 1},
          "build_id": {"type": "string", "pattern": "^build_[0-9a-f]{32}$"},
          "build_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "score_id": {"type": "string", "pattern": "^score_[0-9a-f]{32}$"},
          "score_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "differing_control_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^control_[0-9a-f]{16}$"}
    }
  },
  "additionalProperties": false
}
