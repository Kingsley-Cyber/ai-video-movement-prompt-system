{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/retrieved-passages/1.0",
  "type": "object",
  "required": ["schema", "retrieval", "rights_basis", "passages"],
  "properties": {
    "schema": {"const": "cpcs.retrieved_passages/1.0"},
    "retrieval": {
      "type": "object",
      "required": ["adapter", "corpus_id", "query", "tool", "parameters", "retrieved_at"],
      "properties": {
        "adapter": {"const": "polymath_mcp"},
        "corpus_id": {"type": ["string", "null"]},
        "query": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"},
        "retrieved_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "rights_basis": {"type": "string", "minLength": 1},
    "passages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "locator", "content_hash", "text"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "text": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
