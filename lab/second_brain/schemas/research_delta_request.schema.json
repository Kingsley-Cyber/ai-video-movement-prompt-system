{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/research-delta-request/1.0",
  "type": "object",
  "required": ["schema", "session_id", "objective", "planned_at", "claims"],
  "properties": {
    "schema": {"const": "cpcs.research_delta_request/1.0"},
    "session_id": {"type": "string", "pattern": "^research_session_[0-9a-f]{24}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "planned_at": {"type": "string", "format": "date-time"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/claimSelection"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "closedStrings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "scope": {
      "type": "object",
      "required": ["providers", "models", "domains", "tasks"],
      "properties": {
        "providers": {"$ref": "#/$defs/closedStrings"},
        "models": {"$ref": "#/$defs/closedStrings"},
        "domains": {"$ref": "#/$defs/closedStrings"},
        "tasks": {"$ref": "#/$defs/closedStrings"}
      },
      "additionalProperties": false
    },
    "claimSelection": {
      "type": "object",
      "required": [
        "candidate_id", "knowledge_class", "change_class", "scope",
        "limitations", "implementation_targets"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate_[A-Za-z0-9._-]+$"},
        "knowledge_class": {
          "enum": [
            "established_standard", "research_derived_parameterization",
            "project_specific_synthesis", "empirical_repository_finding", "unverified"
          ]
        },
        "change_class": {
          "enum": [
            "knowledge_only", "contract_affecting", "implementation_affecting",
            "provider_version_affecting", "verification_affecting", "policy_affecting",
            "contradictory_or_unverified"
          ]
        },
        "scope": {"$ref": "#/$defs/scope"},
        "limitations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "implementation_targets": {
          "type": "array",
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "knowledge_record", "typed_relationship", "control_mapping",
              "canonical_score", "provider_capability", "prompt_projection",
              "verification_rule", "experiment_policy", "application_contract"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
