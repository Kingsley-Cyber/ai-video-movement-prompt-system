{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/source-unit/1.0",
  "type": "object",
  "required": [
    "schema", "id", "source_id", "source_ref", "locator",
    "source_byte_hash", "content_sha256", "rights_basis", "media_type",
    "evidence_class", "storage", "aliases", "prior_record_hash", "record_hash"
  ],
  "properties": {
    "schema": {"const": "cpcs.source_unit/1.0"},
    "id": {"type": "string", "pattern": "^source_unit_[0-9a-f]{24}$"},
    "source_id": {"type": "string", "pattern": "^src_sha256_[0-9a-f]{64}$"},
    "source_ref": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1},
    "source_byte_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "rights_basis": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "evidence_class": {
      "enum": ["authored", "measured", "detected", "inferred", "interpreted", "simulated", "derived"]
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "passage"],
          "properties": {
            "kind": {"const": "embedded_passage"},
            "passage": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path", "byte_start", "byte_end", "source_file_sha256"],
          "properties": {
            "kind": {"const": "local_byte_span"},
            "path": {"type": "string", "minLength": 1},
            "byte_start": {"type": "integer", "minimum": 0},
            "byte_end": {"type": "integer", "minimum": 1},
            "source_file_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        }
      ]
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "prior_record_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "record_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
