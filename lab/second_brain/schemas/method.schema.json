{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/method/1.0",
  "type": "object",
  "required": ["id", "concept_ids", "name", "objective", "steps", "inputs", "outputs", "constraints", "failure_conditions", "epistemic_class", "confidence", "status", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^method_[A-Za-z0-9._-]+$"},
    "concept_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^c_[A-Za-z0-9._-]+$"}},
    "name": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "failure_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "epistemic_class": {"enum": ["measured", "detected", "inferred", "interpreted", "authored", "simulated", "derived"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "status": {"enum": ["ingested", "partial", "proven", "deprecated"]},
    "sources": {"$ref": "#/$defs/sources"},
    "provenance": {"type": "object"},
    "validity": {"$ref": "#/$defs/validity"}
  },
  "additionalProperties": false,
  "$defs": {
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "locator"],
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "content_sha256": {"type": ["string", "null"], "pattern": "^(sha256:)?[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "validity": {
      "type": "object",
      "required": ["valid_from", "valid_until", "status", "supersedes", "superseded_by"],
      "properties": {
        "valid_from": {"type": ["string", "null"], "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"},
        "status": {"enum": ["active", "superseded", "deprecated"]},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^method_[A-Za-z0-9._-]+$"}},
        "superseded_by": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^method_[A-Za-z0-9._-]+$"}}
      },
      "additionalProperties": false
    }
  }
}
