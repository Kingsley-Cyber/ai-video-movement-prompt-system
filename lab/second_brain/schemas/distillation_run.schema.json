{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs://second-brain/distillation-run/1.0",
  "type": "object",
  "required": [
    "id",
    "batch_id",
    "input_hash",
    "policy_version",
    "policy_hash",
    "curated_snapshot_hash",
    "retrieval",
    "extractor",
    "candidate_decisions",
    "proposal_ids",
    "summary"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^distill_[0-9a-f]{24}$"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^batch_[A-Za-z0-9._-]+$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_version": {"type": "string", "minLength": 1},
    "policy_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "curated_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "retrieval": {"type": "object"},
    "extractor": {"type": "object"},
    "candidate_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "proposal_type",
          "suggested_id",
          "fingerprint",
          "proposed_record",
          "source_evidence",
          "disposition",
          "reasons",
          "dedup_candidates",
          "hop_alignment",
          "dependencies",
          "refactor_actions",
          "proposal_id"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "proposal_type": {
            "enum": ["concept", "edge", "intent", "mapping", "rule"]
          },
          "suggested_id": {"type": ["string", "null"]},
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "proposed_record": {"type": "object"},
          "source_evidence": {"type": "array", "minItems": 1},
          "disposition": {
            "enum": [
              "stage_new",
              "stage_relationship",
              "stage_mapping",
              "stage_rule",
              "stage_intent",
              "already_curated",
              "already_staged",
              "reject_exact_duplicate",
              "review_possible_duplicate",
              "reject_invalid_reference",
              "reject_unconnected_concept",
              "reject_unhashed_evidence"
            ]
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "dedup_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "reason", "score"],
              "properties": {
                "id": {"type": "string"},
                "reason": {"type": "string"},
                "score": {"type": "number", "minimum": 0, "maximum": 1}
              },
              "additionalProperties": false
            }
          },
          "hop_alignment": {
            "type": "object",
            "required": ["anchors", "existing_path"],
            "properties": {
              "anchors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["concept_id", "score", "reason", "neighbor_ids"],
                  "properties": {
                    "concept_id": {"type": "string"},
                    "score": {"type": "number", "minimum": 0, "maximum": 1},
                    "reason": {"type": "string"},
                    "neighbor_ids": {
                      "type": "array",
                      "items": {"type": "string"}
                    }
                  },
                  "additionalProperties": false
                }
              },
              "existing_path": {
                "type": ["array", "null"],
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          },
          "connectivity": {
            "type": "object",
            "required": [
              "connected",
              "structural_edge_candidate_ids",
              "operational_edge_candidate_ids",
              "mapping_candidate_ids",
              "anchor_path",
              "reasons"
            ],
            "properties": {
              "connected": {"type": "boolean"},
              "structural_edge_candidate_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "operational_edge_candidate_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "mapping_candidate_ids": {
                "type": "array",
                "items": {"type": "string"}
              },
              "anchor_path": {
                "type": ["array", "null"],
                "items": {"type": "string"}
              },
              "reasons": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": false
          },
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "refactor_actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["action", "target_id", "reason"],
              "properties": {
                "action": {
                  "enum": [
                    "add_candidate",
                    "add_relationship_candidate",
                    "add_mapping_candidate",
                    "add_rule_candidate",
                    "add_intent_candidate",
                    "preserve_durable_id",
                    "discard_duplicate",
                    "merge_review",
                    "repair_reference",
                    "supply_connectivity",
                    "supply_evidence_hash"
                  ]
                },
                "target_id": {"type": ["string", "null"]},
                "reason": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "proposal_id": {
            "type": ["string", "null"],
            "pattern": "^proposal_[A-Za-z0-9._-]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "proposal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^proposal_[A-Za-z0-9._-]+$"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "candidates",
        "staged",
        "already_curated",
        "already_staged",
        "exact_duplicates",
        "review_required",
        "invalid"
      ],
      "properties": {
        "candidates": {"type": "integer", "minimum": 0},
        "staged": {"type": "integer", "minimum": 0},
        "already_curated": {"type": "integer", "minimum": 0},
        "already_staged": {"type": "integer", "minimum": 0},
        "exact_duplicates": {"type": "integer", "minimum": 0},
        "review_required": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
