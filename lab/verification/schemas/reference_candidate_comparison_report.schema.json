{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs.reference_candidate_comparison_report/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_id",
    "policy",
    "authority_status",
    "overall_status",
    "reference",
    "candidate",
    "settings",
    "timeline",
    "speech",
    "motion",
    "vog_alignment",
    "assessments",
    "reference_control_candidates",
    "visual_samples",
    "limitations",
    "input_hash"
  ],
  "properties": {
    "schema": {"const": "cpcs.reference_candidate_comparison_report/1.0"},
    "report_id": {"type": "string", "pattern": "^reference_candidate_[0-9a-f]{24}$"},
    "policy": {"const": "cpcs-reference-candidate-comparison/1.0"},
    "authority_status": {"const": "operational_evidence_only"},
    "overall_status": {"enum": ["pass", "fail", "inconclusive"]},
    "reference": {"$ref": "#/$defs/media"},
    "candidate": {"$ref": "#/$defs/media"},
    "settings": {"type": "object"},
    "timeline": {"type": "object"},
    "speech": {"type": "object"},
    "motion": {"type": "object"},
    "vog_alignment": {"$ref": "#/$defs/vogAlignment"},
    "assessments": {"type": "array", "items": {"type": "object"}},
    "reference_control_candidates": {"type": "object"},
    "visual_samples": {"type": "array", "items": {"type": "object"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "input_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "asset_id",
        "sha256",
        "rights_scope",
        "duration_s",
        "width",
        "height",
        "frame_rate",
        "probe_hash"
      ],
      "properties": {
        "source_id": {"type": "string"},
        "asset_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rights_scope": {"type": "string"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_rate": {"type": "number", "exclusiveMinimum": 0},
        "probe_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "observationRef": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation_id",
            "source_ref",
            "interval",
            "subject_refs",
            "claim",
            "claim_hash",
            "provenance"
          ],
          "properties": {
            "observation_id": {"type": "string", "pattern": "^vog_obs_"},
            "source_ref": {"type": "string", "minLength": 1},
            "interval": {"type": "object"},
            "subject_refs": {"type": "array", "items": {"type": "string"}},
            "claim": {"type": "object", "minProperties": 1},
            "claim_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "provenance": {"type": "object", "minProperties": 1}
          }
        }
      ]
    },
    "vogAlignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_class",
        "confidence_averaging",
        "profile_match",
        "subject_mapping",
        "reference_graph",
        "candidate_graph",
        "counts",
        "rows",
        "limitations"
      ],
      "properties": {
        "status": {"enum": ["matching", "diverging", "conflicting", "unobservable", "not_supplied"]},
        "evidence_class": {"const": "interpreted"},
        "confidence_averaging": {"const": false},
        "profile_match": {"type": ["boolean", "null"]},
        "subject_mapping": {
          "type": "object",
          "propertyNames": {"pattern": "^actor_[A-Z]+$"},
          "additionalProperties": {"type": "string", "pattern": "^actor_[A-Z]+$"}
        },
        "reference_graph": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["graph_id", "graph_hash", "artifact_sha256"],
              "properties": {
                "graph_id": {"type": "string", "pattern": "^vog_[0-9a-f]{32}$"},
                "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "candidate_graph": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["graph_id", "graph_hash", "artifact_sha256"],
              "properties": {
                "graph_id": {"type": "string", "pattern": "^vog_[0-9a-f]{32}$"},
                "graph_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["matching", "diverging", "conflicting", "unobservable"],
          "properties": {
            "matching": {"type": "integer", "minimum": 0},
            "diverging": {"type": "integer", "minimum": 0},
            "conflicting": {"type": "integer", "minimum": 0},
            "unobservable": {"type": "integer", "minimum": 0}
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["layer", "profile_id", "status", "phase_error", "reference", "candidate"],
            "properties": {
              "layer": {"type": "string", "minLength": 1},
              "profile_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["matching", "diverging", "conflicting", "unobservable"]},
              "phase_error": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "reference": {"$ref": "#/$defs/observationRef"},
              "candidate": {"$ref": "#/$defs/observationRef"}
            }
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
