{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpcs.reference_candidate_comparison_request/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reference", "candidate", "settings", "assessments"],
  "properties": {
    "schema": {"const": "cpcs.reference_candidate_comparison_request/1.0"},
    "reference": {"$ref": "#/$defs/mediaInput"},
    "candidate": {"$ref": "#/$defs/mediaInput"},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_threshold",
        "normalized_cut_tolerance",
        "minimum_speech_pace_ratio",
        "minimum_pose_speed_ratio",
        "minimum_pause_s",
        "max_pose_gap_s",
        "max_pose_step",
        "pose_actor_mapping",
        "joints",
        "visual_sample_count"
      ],
      "properties": {
        "scene_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "normalized_cut_tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
        "minimum_speech_pace_ratio": {"type": "number", "minimum": 0, "maximum": 2},
        "minimum_pose_speed_ratio": {"type": "number", "minimum": 0, "maximum": 2},
        "minimum_pause_s": {"type": "number", "minimum": 0, "maximum": 10},
        "max_pose_gap_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "max_pose_step": {"type": "number", "exclusiveMinimum": 0, "maximum": 2},
        "pose_actor_mapping": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^actor_[A-Z]+$"},
          "additionalProperties": {"type": "string", "pattern": "^actor_[A-Z]+$"}
        },
        "joints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "visual_sample_count": {"type": "integer", "minimum": 0, "maximum": 12}
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "lane", "status", "finding", "source_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
          "lane": {"enum": ["human_review", "semantic", "local_visual"]},
          "status": {"enum": ["pass", "fail", "unobservable", "conflict"]},
          "finding": {"type": "string", "minLength": 1},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "mediaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "asset_id",
        "local_path",
        "sha256",
        "rights_scope",
        "asr",
        "pose_batch"
      ],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "rights_scope": {"type": "string", "minLength": 1},
        "asr": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "sha256", "model"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "model": {"type": "string", "minLength": 1}
              }
            }
          ]
        },
        "pose_batch": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifactInput"}]
        },
        "video_observation_graph": {"$ref": "#/$defs/artifactInput"}
      }
    }
  }
}
